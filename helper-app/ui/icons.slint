// Line icons on a 24×24 grid with one stroke weight and rounded ends, so they stay
// crisp at any size and take the theme's colors.

export component Icon {
    // Result kinds: "video-effect", "audio-effect", "video-transition", "audio-transition",
    // "preset", "video", "image", "audio", "sequence", "bin", "action", "marker", "other".
    // Interface: "search", "info", "folder".
    in property <string> name;
    in property <color> ink;

    // The outline of every icon.
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.ink;
        stroke-width: 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: root.name == "video-effect" ? "M9.5 20V8.5a3 3 0 0 1 3-3h1M6.5 11h6M14.5 11l5.5 8M20 11l-5.5 8"
            : root.name == "audio-effect" ? "M3 12h1.5M6.5 9v6M10 5.5v13M13.5 8.5v7M17 6.5v11M20.5 10.5v3"
            : root.name == "video-transition" ? "M5.5 4.5h6A2.5 2.5 0 0 1 14 7v6a2.5 2.5 0 0 1-2.5 2.5h-6A2.5 2.5 0 0 1 3 13V7a2.5 2.5 0 0 1 2.5-2.5zM12.5 8.5h6A2.5 2.5 0 0 1 21 11v6a2.5 2.5 0 0 1-2.5 2.5h-6A2.5 2.5 0 0 1 10 17v-6a2.5 2.5 0 0 1 2.5-2.5z"
            : root.name == "audio-transition" ? "M3 7c7 0 11 10 18 10M3 17c7 0 11-10 18-10"
            : root.name == "preset" ? "M4 7h8M17 7h3M14.5 4.5v5M4 17h3M12 17h8M9.5 14.5v5"
            : root.name == "video" ? "M5.5 5h13A2.5 2.5 0 0 1 21 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 16.5v-9A2.5 2.5 0 0 1 5.5 5z"
            : root.name == "image" ? "M5.5 4.5h13A2.5 2.5 0 0 1 21 7v10a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17V7a2.5 2.5 0 0 1 2.5-2.5zM8.5 7.9a1.6 1.6 0 1 0 0 3.2a1.6 1.6 0 1 0 0-3.2zM21 15.5L16.5 11 7 19.5"
            : root.name == "audio" ? "M9 17.5V6.5L19 4v11M6.5 15a2.5 2.5 0 1 0 0 5a2.5 2.5 0 1 0 0-5zM16.5 12.5a2.5 2.5 0 1 0 0 5a2.5 2.5 0 1 0 0-5z"
            : root.name == "sequence" ? "M4.5 5h7A1.5 1.5 0 0 1 13 6.5v1A1.5 1.5 0 0 1 11.5 9h-7A1.5 1.5 0 0 1 3 7.5v-1A1.5 1.5 0 0 1 4.5 5zM9.5 10.5h10A1.5 1.5 0 0 1 21 12v1a1.5 1.5 0 0 1-1.5 1.5h-10A1.5 1.5 0 0 1 8 13v-1a1.5 1.5 0 0 1 1.5-1.5zM4.5 16h5A1.5 1.5 0 0 1 11 17.5v.5a1.5 1.5 0 0 1-1.5 1.5h-5A1.5 1.5 0 0 1 3 18v-.5A1.5 1.5 0 0 1 4.5 16z"
            : root.name == "bin" || root.name == "folder" ? "M3 8a2.5 2.5 0 0 1 2.5-2.5h3.7l2 2h7.3A2.5 2.5 0 0 1 21 10v7a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17z"
            : root.name == "action" ? "M13.5 3L5 13.5h6.5L10.5 21 19 10.5h-6.5z"
            : root.name == "marker" ? "M6.5 4h11v10l-5.5 6-5.5-6z"
            : root.name == "search" ? "M10.5 4a6.5 6.5 0 1 0 0 13a6.5 6.5 0 1 0 0-13zM15.5 15.5L20 20"
            : root.name == "info" ? "M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18zM12 11v5M12 8v.01"
            : "M7 3h7l5 5v13H7zM14 3v5h5";
    }

    // Solid accents: the play button on video, and the second frame of a transition.
    if root.name == "video" || root.name == "video-transition" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.name == "video" ? root.ink : transparent;
        stroke-width: 1.4px;
        stroke-line-join: round;
        fill: root.name == "video" ? root.ink : root.ink.with-alpha(0.22);
        commands: root.name == "video" ? "M10 9.25v5.5l4.75-2.75z"
            : "M12.5 8.5h6A2.5 2.5 0 0 1 21 11v6a2.5 2.5 0 0 1-2.5 2.5h-6A2.5 2.5 0 0 1 10 17v-6a2.5 2.5 0 0 1 2.5-2.5z";
    }
}
