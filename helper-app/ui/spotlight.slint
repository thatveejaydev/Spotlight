export struct EffectItemUI {
    name: string,
    category: string,
    folder: string,
    badge-bg: color,
    badge-fg: color,
}

export struct DebugLogEntryUI {
    text: string,
    color: color,
}

component DebugMetric inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <color> accent;

    background: #1a1c28;
    border-radius: 5px;
    border-width: 1px;
    border-color: #25283a;

    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 2px;

        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 700;
            font-family: "Consolas";
            color: root.accent;
            overflow: elide;
        }
        Text {
            text: root.hint;
            font-size: 9.5px;
            color: #8b90aa;
            overflow: elide;
        }
    }
}

export component DebugLogWindow inherits Window {
    title: "Premiere Spotlight Debug Log";
    no-frame: true;
    always-on-top: true;
    width: panel-width;
    height: panel-height;
    background: #12131a;

    out property <length> panel-width: 560px;
    out property <length> panel-height: 410px;
    in property <string> ui-timer-rate: "0/s";
    in property <string> ws-poll-rate: "0/s";
    in property <string> fg-hook-rate: "0/s";
    in property <string> last-search-text: "—";
    in property <string> last-rtt-text: "—";
    in property <bool> paused: false;
    in property <[DebugLogEntryUI]> log-entries: [];

    callback clear-requested();
    callback toggle-pause();
    callback close-requested();

    Rectangle {
        width: 100%;
        height: 100%;
        background: #12131a;
        border-width: 1px;
        border-color: #363952;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Header bar
            Rectangle {
                height: 38px;
                background: #171822;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: stretch;

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: "Spotlight Debug & Performance Log";
                            font-size: 12px;
                            font-weight: 700;
                            color: #f3f4f8;
                        }
                    }

                    // Pause / Resume button
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 60px;
                            height: 22px;
                            border-radius: 4px;
                            background: pause-touch.has-hover ? #282b3d : #1f2130;
                            border-width: 1px;
                            border-color: root.paused ? #f59e0b88 : #363952;
                            Text {
                                text: root.paused ? "Resume" : "Pause";
                                font-size: 10px;
                                font-weight: 600;
                                color: root.paused ? #fcd34d : #cbd5e1;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            pause-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-pause(); }
                            }
                        }
                    }

                    // Clear button
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 48px;
                            height: 22px;
                            border-radius: 4px;
                            background: clear-touch.has-hover ? #282b3d : #1f2130;
                            border-width: 1px;
                            border-color: #363952;
                            Text {
                                text: "Clear";
                                font-size: 10px;
                                font-weight: 600;
                                color: #cbd5e1;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            clear-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.clear-requested(); }
                            }
                        }
                    }

                    // Close button
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 48px;
                            height: 22px;
                            border-radius: 4px;
                            background: close-touch.has-hover ? #452730 : #1f2130;
                            border-width: 1px;
                            border-color: close-touch.has-hover ? #ca7c85 : #363952;
                            Text {
                                text: "Close";
                                font-size: 10px;
                                font-weight: 600;
                                color: #f8fafc;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            close-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.close-requested(); }
                            }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: #26283a; }

            // Live metrics bar
            Rectangle {
                background: #151620;

                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 6px;
                        DebugMetric {
                            horizontal-stretch: 1;
                            label: "UI Timer: " + root.ui-timer-rate;
                            hint: "Idle UI wakeups (0/s best)";
                            accent: #fbbf24;
                        }
                        DebugMetric {
                            horizontal-stretch: 1;
                            label: "WS Polls: " + root.ws-poll-rate;
                            hint: "Empty bridge checks (0/s best)";
                            accent: #fbbf24;
                        }
                        DebugMetric {
                            horizontal-stretch: 1;
                            label: "FG Hooks: " + root.fg-hook-rate;
                            hint: "App focus switches (0/s hidden)";
                            accent: #93c5fd;
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        DebugMetric {
                            horizontal-stretch: 1;
                            label: "Last Search: " + root.last-search-text;
                            hint: "Filter speed (matches / total items)";
                            accent: #c4b5fd;
                        }
                        DebugMetric {
                            horizontal-stretch: 1;
                            label: "Bridge RTT: " + root.last-rtt-text;
                            hint: "Premiere action round-trip time";
                            accent: #6ee7b7;
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: #26283a; }

            // Scrollable log list
            Rectangle {
                vertical-stretch: 1;
                background: #0f1017;
                clip: true;

                if root.log-entries.length == 0 : VerticalLayout {
                    alignment: center;
                    Text {
                        text: "No debug events recorded yet";
                        font-size: 11px;
                        font-family: "Consolas";
                        color: #6b708b;
                        horizontal-alignment: center;
                    }
                }

                Flickable {
                    width: 100%;
                    height: 100%;
                    content-height: log-list.preferred-height;
                    interactive: true;

                    log-list := VerticalLayout {
                        width: 100%;
                        padding: 8px;
                        spacing: 3px;
                        alignment: start;

                        for entry in root.log-entries : Text {
                            text: entry.text;
                            font-size: 11px;
                            font-family: "Consolas";
                            color: entry.color;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}

export component ErrorToastWindow inherits Window {
    title: "Premiere Spotlight error";
    no-frame: true;
    always-on-top: true;
    width: 304px;
    height: toast-height;
    background: #242427;

    out property <length> toast-height: 54px;
    in property <string> message;

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-width: 1px;
        border-color: #604249;

        Rectangle {
            x: 12px;
            y: (parent.height - self.height) / 2;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: #ca7c85;
        }

        Text {
            x: 26px;
            y: 4px;
            width: parent.width - 38px;
            height: parent.height - 8px;
            text: root.message;
            font-size: 13px;
            color: #e2e2e5;
            vertical-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
    }
}

component ShortcutRecorderRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint: "";
    in property <string> shortcut-text;
    in property <string> empty-text: "Not set";
    in property <bool> recording: false;
    in property <bool> show-clear: true;
    callback toggle-record();
    callback clear-clicked();

    spacing: 10px;
    alignment: stretch;

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.label;
            font-size: 12.5px;
            font-weight: 600;
            color: #f3f4f8;
        }
        if root.hint != "" : Text {
            text: root.hint;
            font-size: 11px;
            color: #8b90aa;
            overflow: elide;
        }
    }

    HorizontalLayout {
        spacing: 6px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            Rectangle {
                min-width: 112px;
                height: 26px;
                border-radius: 6px;
                background: root.recording ? #6366f130 : (slot-touch.has-hover ? #25283a : #1f2233);
                border-width: 1px;
                border-color: root.recording ? #818cf8 : #3a3f5c;
                accessible-role: button;
                accessible-label: root.label;
                accessible-action-default => { root.toggle-record(); }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: center;
                    Text {
                        text: root.recording ? "Press keys…"
                            : (root.shortcut-text != "" ? root.shortcut-text : root.empty-text);
                        font-size: 11px;
                        font-weight: 700;
                        color: root.recording ? #c7d2fe
                            : (root.shortcut-text != "" ? #e2e8f0 : #6b708b);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                slot-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle-record(); }
                }
            }
        }

        if root.show-clear && root.shortcut-text != "" : VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 6px;
                background: clear-touch.has-hover ? #38252d : #1f2130;
                border-width: 1px;
                border-color: clear-touch.has-hover ? #ca7c85 : #363952;
                accessible-role: button;
                accessible-label: "Clear " + root.label;
                accessible-action-default => { root.clear-clicked(); }
                Text {
                    text: "×";
                    font-size: 13px;
                    font-weight: 700;
                    color: #cbd5e1;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                clear-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.clear-clicked(); }
                }
            }
        }
    }
}

export component SpotlightWindow inherits Window {
    title: "";
    no-frame: true;
    always-on-top: true;
    width: 620px;
    height: 407px;
    background: #12131a;

    in-out property <string> search-text: "";
    in-out property <int> selected-index: 0;
    in-out property <string> active-catalog: "all";
    in-out property <string> active-bin: "";
    private property <string> catalog-name: active-catalog == "effects" ? "Effects"
        : active-catalog == "project" ? "Project" : "All";
    private property <color> catalog-accent: active-catalog == "effects" ? #c4b5fd
        : active-catalog == "project" ? #6ee7b7 : #93c5fd;
    in property <bool> show-recent-items: false;
    in-out property <bool> bridge-connected: false;
    in-out property <int> total-matches: 0;
    private property <string> gear-tooltip: settings-open ? "Back to Search"
        : (settings-hotkey-label != "" ? "Settings (" + settings-hotkey-label + ")" : "Settings");
    in-out property <string> hotkey-label: "Ctrl+Space";
    in-out property <string> status-message: "Ready · " + root.hotkey-label;
    in-out property <bool> settings-open: false;
    private property <int> settings-tab-index: 0;
    in-out property <bool> recording-hotkey: false;
    in-out property <string> recording-target: "";
    in-out property <bool> open-effect-controls-default: false;
    in-out property <string> alternate-modifier: "shift";
    private property <string> alternate-modifier-label: alternate-modifier == "ctrl" ? "Ctrl"
        : alternate-modifier == "alt" ? "Alt" : "Shift";
    in-out property <string> settings-hotkey-label: "Ctrl+,";
    in-out property <string> catalog-all-hotkey-label: "";
    in-out property <string> catalog-effects-hotkey-label: "";
    in-out property <string> catalog-project-hotkey-label: "";
    in-out property <string> config-path-display: "";
    in-out property <string> settings-feedback: "";
    in-out property <bool> settings-feedback-error: false;
    in property <[EffectItemUI]> results: [];

    callback search-edited(string);
    callback catalog-changed();
    callback step-out-bin();
    callback move-selection(int);
    callback activate-selected();
    callback activate-index(int);
    callback shift-activate-selected();
    callback shift-activate-index(int);
    callback close-requested();
    callback toggle-debug-log();
    callback toggle-settings();
    callback hotkey-recording-changed(bool);
    callback capture-shortcut(string, string, bool, bool, bool, bool);
    callback clear-shortcut(string);
    callback reset-default-hotkey();
    callback toggle-default-effect-controls();
    callback set-alternate-modifier(string);
    callback try-palette-shortcut(string, bool, bool, bool, bool) -> bool;
    callback open-config-file();
    callback reload-settings();

    public function focus-search() {
        search-input.focus();
        search-input.select-all();
    }

    function begin-recording(target: string) {
        if (root.recording-target == target && root.recording-hotkey) {
            root.set-recording(false);
            return;
        }
        root.recording-target = target;
        root.set-recording(true);
    }

    function set-recording(active: bool) {
        if (!active) {
            root.recording-target = "";
        }
        if (root.recording-hotkey != active) {
            root.recording-hotkey = active;
            root.hotkey-recording-changed(active);
        }
        if (active) {
            if (root.recording-target == "") {
                root.recording-target = "launch";
            }
            root.settings-feedback = "";
            root.settings-feedback-error = false;
            recorder-focus.focus();
        } else if (root.settings-open) {
            settings-focus.focus();
        }
    }

    changed settings-open => {
        if (root.settings-open) {
            root.settings-tab-index = 0;
            if (!root.recording-hotkey) {
                settings-focus.focus();
            }
        }
    }

    function select-settings-tab(index: int) {
        if (root.settings-tab-index != index) {
            root.set-recording(false);
            root.settings-tab-index = index;
        }
    }

    function is-alternate-modifier(mods: KeyboardModifiers) -> bool {
        return root.alternate-modifier == "ctrl" ? mods.control
            : root.alternate-modifier == "alt" ? mods.alt
            : mods.shift;
    }

    function switch-catalog() {
        root.active-catalog = root.active-catalog == "all" ? "effects"
            : root.active-catalog == "effects" ? "project" : "all";
        root.catalog-changed();
        search-input.focus();
    }

    // Catch palette navigation and Escape even if the search input is not focused.
    FocusScope {
        width: 100%;
        height: 100%;
        forward-focus: search-input;

        key-pressed(event) => {
            if (root.settings-open) {
                if (event.text == Key.Escape) {
                    if (root.recording-hotkey) {
                        root.set-recording(false);
                    } else {
                        root.toggle-settings();
                    }
                    return accept;
                }
                if (!root.recording-hotkey && root.try-palette-shortcut(
                    event.text,
                    event.modifiers.control,
                    event.modifiers.alt,
                    event.modifiers.shift,
                    event.modifiers.meta,
                )) {
                    return accept;
                }
                if (event.text == Key.F12 && !root.recording-hotkey) {
                    root.toggle-debug-log();
                    return accept;
                }
                if (!root.recording-hotkey && !event.modifiers.control && !event.modifiers.alt
                    && !event.modifiers.shift && !event.modifiers.meta
                    && (event.text == Key.LeftArrow || event.text == Key.RightArrow)) {
                    root.select-settings-tab(event.text == Key.LeftArrow ? 0 : 1);
                    return accept;
                }
                return reject;
            }
            if (root.try-palette-shortcut(
                event.text,
                event.modifiers.control,
                event.modifiers.alt,
                event.modifiers.shift,
                event.modifiers.meta,
            )) {
                return accept;
            }
            if (event.text == Key.Return && root.is-alternate-modifier(event.modifiers)) {
                root.shift-activate-selected();
                return accept;
            }
            if (event.text == Key.Backspace && root.search-text == "" && root.active-bin != "") {
                root.step-out-bin();
                return accept;
            }
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.move-selection(-1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.move-selection(1);
                return accept;
            }
            if (event.text == Key.Tab) {
                root.switch-catalog();
                return accept;
            }
            if (event.text == Key.F12) {
                root.toggle-debug-log();
                return accept;
            }
            return reject;
        }

        // Outer bordered shell
        Rectangle {
            width: 100%;
            height: 100%;
            background: #12131a;
            border-radius: 10px;
            clip: true;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // 1. Search Bar Header (or Settings Header when settings-open)
            Rectangle {
                height: 54px;
                background: #171822;

                HorizontalLayout {
                    visible: root.settings-open;
                    width: 100%;
                    height: 100%;
                    padding-left: 16px;
                    padding-right: 14px;
                    spacing: 12px;
                    alignment: stretch;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "Settings";
                            font-size: 14px;
                            font-weight: 700;
                            color: #f3f4f8;
                        }
                        Text {
                            visible: root.settings-tab-index == 0;
                            text: "Hotkeys and preferences apply immediately";
                            font-size: 11px;
                            color: #8b90aa;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 72px;
                            height: 26px;
                            border-radius: 6px;
                            background: back-touch.has-hover ? #282b3d : #1f2130;
                            border-width: 1px;
                            border-color: #363952;
                            accessible-role: button;
                            accessible-label: "Back to search";
                            accessible-action-default => { root.toggle-settings(); }
                            Text {
                                text: "← Back";
                                font-size: 11px;
                                font-weight: 600;
                                color: #dcdfe8;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            back-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-settings(); }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    visible: !root.settings-open;
                    width: 100%;
                    height: 100%;
                    padding-left: 16px;
                    padding-right: 14px;
                    spacing: 12px;
                    alignment: stretch;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 24px;
                            border-radius: 6px;
                            background: root.catalog-accent.with-alpha(catalog-touch.has-hover ? 0.25 : 0.12);
                            border-width: 1px;
                            border-color: root.catalog-accent.with-alpha(0.4);
                            accessible-role: button;
                            accessible-label: root.catalog-name + " catalog. Switch catalog";
                            accessible-action-default => { root.switch-catalog(); }
                            Text {
                                text: root.active-catalog == "effects" ? "FX"
                                    : root.active-catalog == "project" ? "PRJ" : "ALL";
                                font-size: 10px;
                                font-weight: 700;
                                color: root.catalog-accent;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            catalog-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.switch-catalog(); }
                            }
                            Tooltip {
                                text: @markdown("\{root.catalog-name}");
                            }
                        }
                    }

                    if root.active-bin != "" : VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 24px;
                            max-width: 210px;
                            border-radius: 6px;
                            background: bin-touch.has-hover ? #6ee7b730 : #6ee7b71a;
                            border-width: 1px;
                            border-color: #6ee7b766;
                            accessible-role: button;
                            accessible-label: "Inside bin " + root.active-bin + ". Step up one level";
                            accessible-action-default => { root.step-out-bin(); }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 7px;
                                spacing: 5px;
                                alignment: center;
                                Text {
                                    text: root.active-bin;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: #a7f3d0;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: "×";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #6ee7b7;
                                    vertical-alignment: center;
                                }
                            }
                            bin-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.step-out-bin(); }
                            }
                            Tooltip {
                                text: @markdown("\{root.active-bin} (Backspace or click to go up)");
                            }
                        }
                    }

                    // Input box container
                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;

                        // Placeholder text when empty
                        if root.search-text == "" : Text {
                            x: 0px;
                            width: 100%;
                            height: 100%;
                            text: root.active-bin != "" ? "Search in \{root.active-bin}…"
                                : root.active-catalog == "effects" ? "Search effects and transitions…"
                                : root.active-catalog == "project" ? "Search project items…"
                                : "Search effects and project items…";
                            color: #5e627c;
                            font-size: 13.5px;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        search-input := TextInput {
                            enabled: !root.settings-open;
                            x: 0px;
                            width: 100%;
                            height: 100%;
                            text <=> root.search-text;
                            font-size: 15px;
                            color: #f3f4f8;
                            selection-background-color: #6366f166;
                            selection-foreground-color: #ffffff;
                            vertical-alignment: center;
                            single-line: true;

                            edited => {
                                root.search-edited(self.text);
                            }

                            accepted => {
                                root.activate-selected();
                            }

                            key-pressed(event) => {
                                if (root.try-palette-shortcut(
                                    event.text,
                                    event.modifiers.control,
                                    event.modifiers.alt,
                                    event.modifiers.shift,
                                    event.modifiers.meta,
                                )) {
                                    return accept;
                                }
                                if (event.text == Key.Return && root.is-alternate-modifier(event.modifiers)) {
                                    root.shift-activate-selected();
                                    return accept;
                                }
                                if (event.text == Key.Backspace && root.search-text == "" && root.active-bin != "") {
                                    root.step-out-bin();
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    root.move-selection(-1);
                                    return accept;
                                }
                                if (event.text == Key.DownArrow) {
                                    root.move-selection(1);
                                    return accept;
                                }
                                if (event.text == Key.Tab) {
                                    root.switch-catalog();
                                    return accept;
                                }
                                if (event.text == Key.F12) {
                                    root.toggle-debug-log();
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                }
            }

            // Divider
            Rectangle {
                height: 1px;
                background: #26283a;
            }

            // Eight visible results (or Settings panel)
            Rectangle {
                height: 314px;
                background: #12131a;
                clip: true;

                // Settings tabs and their content
                Rectangle {
                    visible: root.settings-open;
                    width: 100%;
                    height: 100%;

                    settings-focus := FocusScope {
                        width: 0px;
                        height: 0px;
                        enabled: root.settings-open && !root.recording-hotkey;
                    }

                    recorder-focus := FocusScope {
                        width: 0px;
                        height: 0px;
                        enabled: root.settings-open && root.recording-hotkey;
                        key-pressed(event) => {
                            if (!root.recording-hotkey) {
                                return reject;
                            }
                            if (event.text == Key.Escape) {
                                root.set-recording(false);
                                return accept;
                            }
                            root.capture-shortcut(
                                root.recording-target,
                                event.text,
                                event.modifiers.control,
                                event.modifiers.alt,
                                event.modifiers.shift,
                                event.modifiers.meta,
                            );
                            return accept;
                        }
                    }

                    VerticalLayout {
                        width: 100%;
                        height: 100%;
                        padding: 0px;
                        spacing: 0px;

                        Rectangle {
                            height: 38px;
                            background: #171822;
                            accessible-role: tab-list;
                            accessible-label: "Settings sections";
                            accessible-item-count: 2;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-top: 5px;
                                padding-bottom: 6px;
                                spacing: 6px;
                                alignment: start;

                                for title[index] in ["Shortcuts", "About"] : Rectangle {
                                    width: 88px;
                                    border-radius: 6px;
                                    background: index == root.settings-tab-index ? #292d49
                                        : (tab-touch.has-hover ? #222538 : transparent);
                                    border-width: index == root.settings-tab-index ? 1px : 0px;
                                    border-color: #656bba;
                                    accessible-role: tab;
                                    accessible-label: title;
                                    accessible-item-index: index;
                                    accessible-item-selectable: true;
                                    accessible-item-selected: index == root.settings-tab-index;
                                    accessible-action-default => { root.select-settings-tab(index); }
                                    Text {
                                        text: title;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: index == root.settings-tab-index ? #e0e2ff : #a9adc3;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    tab-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.select-settings-tab(index); }
                                    }
                                }
                            }
                        }

                        if root.settings-tab-index == 0 && root.settings-feedback != "" : Rectangle {
                            background: root.settings-feedback-error ? #3b1d24 : #163028;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                Text {
                                    text: root.settings-feedback;
                                    font-size: 11px;
                                    color: root.settings-feedback-error ? #fca5a5 : #6ee7b7;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        if root.settings-tab-index == 0 : Flickable {
                            vertical-stretch: 1;
                            content-height: settings-list.preferred-height;
                            interactive: true;

                            settings-list := VerticalLayout {
                                width: 100%;
                                padding: 14px;
                                spacing: 10px;
                                alignment: start;

                                // Card 1: Launch Hotkey
                                Rectangle {
                                    background: #171822;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #26293d;

                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 8px;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: stretch;

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "Launch Hotkey";
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    color: #f3f4f8;
                                                }
                                                Text {
                                                    text: "Global shortcut to open Spotlight in Premiere Pro";
                                                    font-size: 11px;
                                                    color: #8b90aa;
                                                    overflow: elide;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: center;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        min-width: 122px;
                                                        height: 28px;
                                                        border-radius: 6px;
                                                        background: (root.recording-hotkey && root.recording-target == "launch") ? #6366f130
                                                            : (record-touch.has-hover ? #25283a : #1f2233);
                                                        border-width: 1px;
                                                        border-color: (root.recording-hotkey && root.recording-target == "launch") ? #818cf8 : #3a3f5c;
                                                        accessible-role: button;
                                                        accessible-label: "Change launch hotkey";
                                                        accessible-action-default => { root.begin-recording("launch"); }

                                                        HorizontalLayout {
                                                            padding-left: 10px;
                                                            padding-right: 10px;
                                                            alignment: center;
                                                            Text {
                                                                text: (root.recording-hotkey && root.recording-target == "launch") ? "Press keys…" : root.hotkey-label;
                                                                font-size: 11.5px;
                                                                font-weight: 700;
                                                                color: (root.recording-hotkey && root.recording-target == "launch") ? #c7d2fe : #e2e8f0;
                                                                horizontal-alignment: center;
                                                                vertical-alignment: center;
                                                            }
                                                        }

                                                        record-touch := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.begin-recording("launch"); }
                                                        }
                                                        Tooltip {
                                                            text: @markdown("Click then press a new key combination (Esc to cancel)");
                                                        }
                                                    }
                                                }

                                                if root.hotkey-label != "Ctrl+Space" : VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 52px;
                                                        height: 28px;
                                                        border-radius: 6px;
                                                        background: reset-touch.has-hover ? #282b3d : #1f2130;
                                                        border-width: 1px;
                                                        border-color: #363952;
                                                        accessible-role: button;
                                                        accessible-label: "Reset hotkey to Ctrl+Space";
                                                        accessible-action-default => { root.reset-default-hotkey(); }
                                                        Text {
                                                            text: "Reset";
                                                            font-size: 11px;
                                                            font-weight: 600;
                                                            color: #cbd5e1;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                        }
                                                        reset-touch := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.set-recording(false);
                                                                root.reset-default-hotkey();
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Card 2: Effect Controls on Enter
                                Rectangle {
                                    background: #171822;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #26293d;

                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 12px;
                                        alignment: stretch;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: "Always open Effect Controls on Enter";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: #f3f4f8;
                                            }
                                            Text {
                                                text: root.open-effect-controls-default
                                                    ? "Enter applies & opens Effect Controls · " + root.alternate-modifier-label + "+Enter applies only"
                                                    : "Enter applies only · " + root.alternate-modifier-label + "+Enter opens Effect Controls";
                                                font-size: 11px;
                                                color: #8b90aa;
                                                overflow: elide;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 40px;
                                                height: 22px;
                                                border-radius: 11px;
                                                background: root.open-effect-controls-default ? #6366f1 : #2a2d40;
                                                border-width: 1px;
                                                border-color: root.open-effect-controls-default ? #818cf8 : #3a3f5c;
                                                accessible-role: checkbox;
                                                accessible-label: "Always open Effect Controls on Enter";
                                                accessible-checked: root.open-effect-controls-default;
                                                accessible-action-default => { root.toggle-default-effect-controls(); }

                                                Rectangle {
                                                    x: root.open-effect-controls-default ? 20px : 3px;
                                                    y: 3px;
                                                    width: 14px;
                                                    height: 14px;
                                                    border-radius: 7px;
                                                    background: #ffffff;
                                                    animate x { duration: 120ms; }
                                                }

                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.set-recording(false);
                                                        root.toggle-default-effect-controls();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Card 3: Alternate Action Modifier
                                Rectangle {
                                    background: #171822;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #26293d;

                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 12px;
                                        alignment: stretch;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: "Alternate Action Modifier";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: #f3f4f8;
                                            }
                                            Text {
                                                text: root.alternate-modifier-label + "+Enter / " + root.alternate-modifier-label + "+Click triggers Source Monitor or Effect Controls swap";
                                                font-size: 11px;
                                                color: #8b90aa;
                                                overflow: elide;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 4px;
                                            alignment: center;

                                            for opt in [
                                                { id: "shift", title: "Shift" },
                                                { id: "ctrl", title: "Ctrl" },
                                                { id: "alt", title: "Alt" },
                                            ] : VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 44px;
                                                    height: 26px;
                                                    border-radius: 5px;
                                                    background: root.alternate-modifier == opt.id ? #6366f130
                                                        : (mod-touch.has-hover ? #282b3d : #1f2130);
                                                    border-width: 1px;
                                                    border-color: root.alternate-modifier == opt.id ? #818cf8 : #363952;
                                                    Text {
                                                        text: opt.title;
                                                        font-size: 11px;
                                                        font-weight: root.alternate-modifier == opt.id ? 700 : 500;
                                                        color: root.alternate-modifier == opt.id ? #c7d2fe : #cbd5e1;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    mod-touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.set-recording(false);
                                                            root.set-alternate-modifier(opt.id);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Card 4: Open Settings Shortcut
                                Rectangle {
                                    background: #171822;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #26293d;

                                    VerticalLayout {
                                        padding: 12px;
                                        ShortcutRecorderRow {
                                            label: "Open Settings Shortcut";
                                            hint: "Press inside Spotlight to toggle Settings";
                                            shortcut-text: root.settings-hotkey-label;
                                            recording: root.recording-hotkey && root.recording-target == "settings";
                                            toggle-record => { root.begin-recording("settings"); }
                                            clear-clicked => {
                                                root.set-recording(false);
                                                root.clear-shortcut("settings");
                                            }
                                        }
                                    }
                                }

                                // Card 5: Direct Catalog Shortcuts
                                Rectangle {
                                    background: #171822;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #26293d;

                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 8px;

                                        ShortcutRecorderRow {
                                            label: "Switch to All Catalog";
                                            hint: "Optional shortcut inside Spotlight (empty by default)";
                                            shortcut-text: root.catalog-all-hotkey-label;
                                            recording: root.recording-hotkey && root.recording-target == "catalog_all";
                                            toggle-record => { root.begin-recording("catalog_all"); }
                                            clear-clicked => {
                                                root.set-recording(false);
                                                root.clear-shortcut("catalog_all");
                                            }
                                        }

                                        ShortcutRecorderRow {
                                            label: "Switch to Effects Catalog";
                                            shortcut-text: root.catalog-effects-hotkey-label;
                                            recording: root.recording-hotkey && root.recording-target == "catalog_effects";
                                            toggle-record => { root.begin-recording("catalog_effects"); }
                                            clear-clicked => {
                                                root.set-recording(false);
                                                root.clear-shortcut("catalog_effects");
                                            }
                                        }

                                        ShortcutRecorderRow {
                                            label: "Switch to Project Catalog";
                                            shortcut-text: root.catalog-project-hotkey-label;
                                            recording: root.recording-hotkey && root.recording-target == "catalog_project";
                                            toggle-record => { root.begin-recording("catalog_project"); }
                                            clear-clicked => {
                                                root.set-recording(false);
                                                root.clear-shortcut("catalog_project");
                                            }
                                        }
                                    }
                                }

                                // Card 6: Config file location & actions
                                Rectangle {
                                    background: #171822;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #26293d;

                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 10px;
                                        alignment: stretch;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: "Config File";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: #f3f4f8;
                                            }
                                            Text {
                                                text: root.config-path-display;
                                                font-size: 10.5px;
                                                font-family: "Consolas";
                                                color: #8b90aa;
                                                overflow: elide;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: center;

                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 72px;
                                                    height: 26px;
                                                    border-radius: 6px;
                                                    background: open-cfg-touch.has-hover ? #282b3d : #1f2130;
                                                    border-width: 1px;
                                                    border-color: #363952;
                                                    accessible-role: button;
                                                    accessible-label: "Open config file";
                                                    accessible-action-default => { root.open-config-file(); }
                                                    Text {
                                                        text: "Open File";
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        color: #cbd5e1;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    open-cfg-touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.set-recording(false);
                                                            root.open-config-file();
                                                        }
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 58px;
                                                    height: 26px;
                                                    border-radius: 6px;
                                                    background: reload-cfg-touch.has-hover ? #282b3d : #1f2130;
                                                    border-width: 1px;
                                                    border-color: #363952;
                                                    accessible-role: button;
                                                    accessible-label: "Reload config file";
                                                    accessible-action-default => { root.reload-settings(); }
                                                    Text {
                                                        text: "Reload";
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        color: #cbd5e1;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    reload-cfg-touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.set-recording(false);
                                                            root.reload-settings();
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if !root.settings-open && root.results.length == 0 : VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.active-bin != "" && root.search-text == "" ? "This bin is empty"
                            : root.show-recent-items ? "No recently added items"
                            : "No matching results";
                        font-size: 13px;
                        color: #6b708b;
                        horizontal-alignment: center;
                    }
                }

                VerticalLayout {
                    visible: !root.settings-open;
                    width: 100%;
                    height: 100%;
                    padding: 6px;
                    spacing: 2px;
                    alignment: start;

                    for item[idx] in root.results : Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: idx == root.selected-index ? #6366f12e : (row-touch.has-hover ? #1c1e2b : transparent);
                        border-width: idx == root.selected-index ? 1px : 0px;
                        border-color: #6366f188;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;

                            // Result name and selected project item's bin path side-by-side
                            HorizontalLayout {
                                horizontal-stretch: 1;
                                spacing: 10px;

                                VerticalLayout {
                                    horizontal-stretch: (idx == root.selected-index && item.folder != "") ? 0 : 1;
                                    max-width: (idx == root.selected-index && item.folder != "") ? 260px : 1000px;
                                    alignment: center;
                                    Text {
                                        text: item.name;
                                        font-size: 13px;
                                        font-weight: idx == root.selected-index ? 600 : 400;
                                        color: idx == root.selected-index ? #ffffff : #dcdfe8;
                                        overflow: elide;
                                    }
                                }

                                if idx == root.selected-index && item.folder != "" : Rectangle {
                                    horizontal-stretch: 1;
                                    background: transparent;

                                    Rectangle {
                                        x: 0px;
                                        y: (parent.height - self.height) / 2;
                                        width: min(parent.width, folder-text.preferred-width + 14px);
                                        height: 20px;
                                        border-radius: 4px;
                                        background: #1f2233;
                                        border-width: 1px;
                                        border-color: #3a3f5c;

                                        folder-text := Text {
                                            x: 7px;
                                            width: parent.width - 14px;
                                            height: 100%;
                                            text: item.folder;
                                            font-size: 10.5px;
                                            color: #b4b9d4;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }

                            // Category pill
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 98px;
                                    height: 20px;
                                    border-radius: 4px;
                                    background: item.badge-bg;
                                    Text {
                                        text: item.category;
                                        font-size: 10px;
                                        font-weight: 600;
                                        color: item.badge-fg;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        row-touch := TouchArea {
                            property <bool> shift-click;
                            mouse-cursor: pointer;
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down) {
                                    self.shift-click = root.is-alternate-modifier(event.modifiers);
                                }
                            }
                            clicked => {
                                if (self.shift-click) {
                                    root.shift-activate-index(idx);
                                } else {
                                    root.activate-index(idx);
                                }
                            }
                        }
                    }
                }
            }

            // Divider
            Rectangle {
                height: 1px;
                background: #222434;
            }

            // Footer
            Rectangle {
                height: 36px;
                background: #151620;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;

                    // Connection status indicator
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 7px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: root.bridge-connected ? #22c55e : #f59e0b;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: root.status-message;
                                font-size: 11px;
                                color: #8b90aa;
                                wrap: word-wrap;
                                height: 30px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    if !root.settings-open : VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.show-recent-items ? "Recently added"
                                : root.total-matches == 1 ? "1 result" : root.total-matches + " results";
                            font-size: 11px;
                            color: #8b90aa;
                        }
                    }

                    // Lower-right Settings gear button
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 5px;
                            background: root.settings-open ? #6366f133
                                : (gear-touch.has-hover ? #25283a : transparent);
                            border-width: root.settings-open ? 1px : 0px;
                            border-color: #818cf888;
                            accessible-role: button;
                            accessible-label: root.settings-open ? "Close settings" : "Open settings";
                            accessible-action-default => { root.toggle-settings(); }

                            Path {
                                x: 5px;
                                y: 5px;
                                width: 14px;
                                height: 14px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                fill: root.settings-open ? #c7d2fe
                                    : (gear-touch.has-hover ? #dcdfe8 : #8b90aa);
                                commands: "M19.14 12.94c.04-.31.06-.63.06-.94s-.02-.63-.06-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96a7.03 7.03 0 0 0-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.44.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.74 8.87a.48.48 0 0 0 .12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.49.38 1.03.7 1.62.94l.36 2.54c.03.24.23.41.47.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.48.48 0 0 0-.12-.61l-2.01-1.58z";
                            }
                            Rectangle {
                                x: 9.5px;
                                y: 9.5px;
                                width: 5px;
                                height: 5px;
                                border-radius: 2.5px;
                                background: root.settings-open ? #1d2038 : (gear-touch.has-hover ? #25283a : #151620);
                            }

                            gear-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-settings(); }
                            }
                            Tooltip {
                                text: @markdown("\{root.gear-tooltip}");
                            }
                        }
                    }

                }
            }
        }
        }
    }

    // Draw over the content and inset from the native window's clipping edge.
    Rectangle {
        x: 1px;
        y: 1px;
        width: root.width - 2px;
        height: root.height - 2px;
        border-width: 1.5px;
        border-color: #363952;
        border-radius: 9px;
    }
}
