export struct EffectItemUI {
    name: string,
    category: string,
    folder: string,
    badge-bg: color,
    badge-fg: color,
}

export component ErrorToastWindow inherits Window {
    title: "Premiere Spotlight error";
    no-frame: true;
    always-on-top: true;
    width: 304px;
    height: toast-height;
    background: #242427;

    out property <length> toast-height: 54px;
    in property <string> message;

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-width: 1px;
        border-color: #604249;

        Rectangle {
            x: 12px;
            y: (parent.height - self.height) / 2;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: #ca7c85;
        }

        Text {
            x: 26px;
            y: 4px;
            width: parent.width - 38px;
            height: parent.height - 8px;
            text: root.message;
            font-size: 13px;
            color: #e2e2e5;
            vertical-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
    }
}

export component SpotlightWindow inherits Window {
    title: "";
    no-frame: true;
    always-on-top: true;
    width: 620px;
    height: 407px;
    background: #12131a;

    in-out property <string> search-text: "";
    in-out property <int> selected-index: 0;
    in-out property <string> active-catalog: "all";
    private property <string> catalog-name: active-catalog == "effects" ? "Effects"
        : active-catalog == "project" ? "Project" : "All";
    private property <color> catalog-accent: active-catalog == "effects" ? #c4b5fd
        : active-catalog == "project" ? #6ee7b7 : #93c5fd;
    in property <bool> show-recent-items: false;
    in-out property <bool> bridge-connected: false;
    in-out property <int> total-matches: 0;
    in-out property <string> status-message: "Ready · Ctrl+Space";
    in property <[EffectItemUI]> results: [];

    callback search-edited(string);
    callback catalog-changed();
    callback move-selection(int);
    callback activate-selected();
    callback activate-index(int);
    callback close-requested();

    public function focus-search() {
        search-input.focus();
        search-input.select-all();
    }

    function switch-catalog() {
        root.active-catalog = root.active-catalog == "all" ? "effects"
            : root.active-catalog == "effects" ? "project" : "all";
        root.catalog-changed();
        search-input.focus();
    }

    // Catch palette navigation and Escape even if the search input is not focused.
    FocusScope {
        width: 100%;
        height: 100%;
        forward-focus: search-input;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.move-selection(-1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.move-selection(1);
                return accept;
            }
            if (event.text == Key.Tab) {
                root.switch-catalog();
                return accept;
            }
            return reject;
        }

        // Outer bordered shell
        Rectangle {
            width: 100%;
            height: 100%;
            background: #12131a;
            border-radius: 10px;
            clip: true;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // 1. Search Bar Header
            Rectangle {
                height: 54px;
                background: #171822;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 14px;
                    spacing: 12px;
                    alignment: stretch;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 24px;
                            border-radius: 6px;
                            background: root.catalog-accent.with-alpha(catalog-touch.has-hover ? 0.25 : 0.12);
                            border-width: 1px;
                            border-color: root.catalog-accent.with-alpha(0.4);
                            accessible-role: button;
                            accessible-label: root.catalog-name + " catalog. Switch catalog";
                            accessible-action-default => { root.switch-catalog(); }
                            Text {
                                text: root.active-catalog == "effects" ? "FX"
                                    : root.active-catalog == "project" ? "PRJ" : "ALL";
                                font-size: 10px;
                                font-weight: 700;
                                color: root.catalog-accent;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            catalog-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.switch-catalog(); }
                            }
                            Tooltip {
                                text: @markdown("\{root.catalog-name}");
                            }
                        }
                    }

                    // Input box container
                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;

                        // Placeholder text when empty
                        if root.search-text == "" : Text {
                            x: 0px;
                            width: 100%;
                            height: 100%;
                            text: root.active-catalog == "effects" ? "Search effects and transitions…"
                                : root.active-catalog == "project" ? "Search project items…"
                                : "Search effects and project items…";
                            color: #5e627c;
                            font-size: 13.5px;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        search-input := TextInput {
                            x: 0px;
                            width: 100%;
                            height: 100%;
                            text <=> root.search-text;
                            font-size: 15px;
                            color: #f3f4f8;
                            selection-background-color: #6366f166;
                            selection-foreground-color: #ffffff;
                            vertical-alignment: center;
                            single-line: true;

                            edited => {
                                root.search-edited(self.text);
                            }

                            accepted => {
                                root.activate-selected();
                            }

                            key-pressed(event) => {
                                if (event.text == Key.UpArrow) {
                                    root.move-selection(-1);
                                    return accept;
                                }
                                if (event.text == Key.DownArrow) {
                                    root.move-selection(1);
                                    return accept;
                                }
                                if (event.text == Key.Tab) {
                                    root.switch-catalog();
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                }
            }

            // Divider
            Rectangle {
                height: 1px;
                background: #26283a;
            }

            // Eight visible results
            Rectangle {
                height: 314px;
                background: #12131a;
                clip: true;

                if root.results.length == 0 : VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.show-recent-items ? "No recently added items" : "No matching results";
                        font-size: 13px;
                        color: #6b708b;
                        horizontal-alignment: center;
                    }
                }

                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    alignment: start;

                    for item[idx] in root.results : Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: idx == root.selected-index ? #6366f12e : (row-touch.has-hover ? #1c1e2b : transparent);
                        border-width: idx == root.selected-index ? 1px : 0px;
                        border-color: #6366f188;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;

                            // Result name and selected project item's bin path
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: item.name;
                                    font-size: 13px;
                                    font-weight: idx == root.selected-index ? 600 : 400;
                                    color: idx == root.selected-index ? #ffffff : #dcdfe8;
                                    overflow: elide;
                                }
                                if idx == root.selected-index && item.folder != "" : Text {
                                    text: item.folder;
                                    font-size: 10px;
                                    color: #a5a8c0;
                                    overflow: elide;
                                }
                            }

                            // Category pill
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 98px;
                                    height: 20px;
                                    border-radius: 4px;
                                    background: item.badge-bg;
                                    Text {
                                        text: item.category;
                                        font-size: 10px;
                                        font-weight: 600;
                                        color: item.badge-fg;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        row-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.activate-index(idx);
                            }
                        }
                    }
                }
            }

            // Divider
            Rectangle {
                height: 1px;
                background: #222434;
            }

            // Footer
            Rectangle {
                height: 36px;
                background: #151620;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;

                    // Connection status indicator
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 7px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: root.bridge-connected ? #22c55e : #f59e0b;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: root.status-message;
                                font-size: 11px;
                                color: #8b90aa;
                                wrap: word-wrap;
                                height: 30px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.show-recent-items ? "Recently added"
                                : root.total-matches == 1 ? "1 result" : root.total-matches + " results";
                            font-size: 11px;
                            color: #8b90aa;
                        }
                    }

                }
            }
        }
        }
    }

    // Draw over the content and inset from the native window's clipping edge.
    Rectangle {
        x: 1px;
        y: 1px;
        width: root.width - 2px;
        height: root.height - 2px;
        border-width: 1.5px;
        border-color: #363952;
        border-radius: 9px;
    }
}
