import { AboutSlint, ComboBox, Palette } from "std-widgets.slint";
import { PaletteThemeColors as Theme } from "palette-theme.slint";
import { ShortcutRecorderRow, SettingsToggle, KeyHint, TextTab } from "settings-rows.slint";
import { Icon } from "icons.slint";

// Rust also creates these windows, so the file that slint-build compiles re-exports them.
export { DebugLogWindow, DebugLogEntryUI } from "debug-log.slint";
export { ErrorToastWindow } from "error-toast.slint";

export struct EffectItemUI {
    name: string,
    // Quiet text at the row's right edge: the kind of effect, a bin path or a marker's sequence.
    detail: string,
    // A second line on the highlighted row: why it can't run, or what an action does.
    subtitle: string,
    // The kind icon, as named in icons.slint, its color, and the darker color the Light theme uses.
    icon: string,
    tint: color,
    ink: color,
    // True when the primary action can't run now; `subtitle` says why.
    disabled: bool,
    // True for a Library file the project doesn't hold yet, which Enter imports first.
    needs-import: bool,
}

// A tracked Library folder in Settings, and what the indexer found in it.
export struct LibraryFolderUI {
    path: string,
    detail: string,
}

export struct ActionHotkeyUI {
    id: string,
    label: string,
    hint: string,
    shortcut: string,
}

export component SpotlightWindow inherits Window {
    title: "";
    no-frame: true;
    always-on-top: true;
    width: 620px;
    height: 440px;
    background: Theme.window-background;

    in-out property <string> theme-name <=> Theme.theme-name;
    out property <color> caption-color: Theme.header-background;
    private property <[string]> theme-options: ["Light", "Dark", "Midnight Indigo", "Premiere"];
    private property <int> saved-theme-index: Theme.light ? 0 : (Theme.indigo ? 2 : (root.theme-name == "Dark" ? 1 : 3));
    private property <int> theme-selection: root.saved-theme-index;
    callback select-theme(string);

    function sync-theme() {
        Palette.color-scheme = Theme.light ? ColorScheme.light : ColorScheme.dark;
        root.theme-selection = root.saved-theme-index;
    }

    init => { root.sync-theme(); }
    changed theme-name => { root.sync-theme(); }

    in property <string> app-version;
    in-out property <string> search-text: "";
    in-out property <int> selected-index: 0;
    in-out property <string> active-catalog: "all";
    in-out property <string> active-bin: "";
    in property <bool> marker-picker: false;
    // True while the search box is the name field of Add Named Marker.
    in property <bool> marker-naming: false;
    in property <string> marker-status: "";
    in property <string> marker-context: "";
    in property <bool> show-recent-items: false;
    // True while Premiere is still building the project list.
    in property <bool> project-loading: false;
    private property <bool> show-project-loading: project-loading
        && (active-catalog == "all" || active-catalog == "project");
    in-out property <bool> bridge-connected: false;
    in-out property <int> total-matches: 0;
    private property <string> gear-tooltip: settings-open ? "Back to Search"
        : (settings-hotkey-label != "" ? "Settings (" + settings-hotkey-label + ")" : "Settings");
    in-out property <string> hotkey-label: "Ctrl+Space";
    // Set from settings::DEFAULT_HOTKEY so the Reset button matches the real default.
    in property <string> default-hotkey: "Ctrl+Space";
    // A short-lived result such as "Applied Blur to 2 clips"; `status-visible` is true while it shows.
    in-out property <string> status-message: "";
    in property <bool> status-visible: false;
    // What Enter, the alternate modifier with Enter, and Esc do for the highlighted row.
    in property <string> hint-enter: "";
    in property <string> hint-alternate: "";
    in property <string> hint-escape: "Close";
    // A message that replaces the key hints: marker progress, audio preview problems, a
    // short-lived result, or a lost connection.
    private property <string> footer-message: root.marker-picker && root.marker-status != "" && root.results.length > 0 ? root.marker-status
        : root.preview-message != "" ? root.preview-message
        : root.status-visible ? root.status-message
        : !root.bridge-connected ? "Not connected to Premiere"
        : "";
    in-out property <bool> settings-open: false;
    in-out property <int> settings-tab-index: 0;
    in-out property <bool> recording-hotkey: false;
    in-out property <string> recording-target: "";
    in-out property <bool> open-effect-controls-default: false;
    in-out property <string> alternate-modifier: "shift";
    private property <string> alternate-modifier-label: alternate-modifier == "ctrl" ? "Ctrl"
        : alternate-modifier == "alt" ? "Alt" : "Shift";
    in-out property <string> settings-hotkey-label: "Ctrl+,";
    in-out property <string> catalog-all-hotkey-label: "";
    in-out property <string> catalog-effects-hotkey-label: "";
    in-out property <string> catalog-project-hotkey-label: "";
    in-out property <string> catalog-library-hotkey-label: "";
    in-out property <string> catalog-actions-hotkey-label: "";
    in property <string> audio-preview-hotkey-label: "Ctrl+P";
    in property <[ActionHotkeyUI]> action-hotkeys;
    in property <[LibraryFolderUI]> library-folders;
    in property <int> library-folder-count: 0;
    in property <string> action-hotkeys-warning;
    in property <bool> auto-preview-audio: false;
    in property <bool> preview-active: false;
    in property <string> preview-message: "";
    in property <string> preview-time: "";
    in property <float> preview-progress: 0;
    in property <bool> preview-playing: false;
    in property <bool> preview-can-seek: false;
    in property <bool> preview-can-toggle: false;
    in-out property <string> config-path-display: "";
    in-out property <string> settings-feedback: "";
    in-out property <bool> settings-feedback-error: false;
    in property <[EffectItemUI]> results: [];
    // The visible row that briefly flashes after activating it while it is disabled, or -1.
    in property <int> flash-row: -1;

    callback search-edited(string);
    callback catalog-changed();
    callback step-out-bin();
    callback move-selection(int);
    callback activate-selected();
    callback activate-index(int);
    callback shift-activate-selected();
    callback shift-activate-index(int);
    callback close-requested();
    callback toggle-debug-log();
    callback toggle-settings();
    callback hotkey-recording-changed(bool);
    callback capture-shortcut(string, string, bool, bool, bool, bool);
    callback clear-shortcut(string);
    callback reset-default-hotkey();
    callback toggle-default-effect-controls();
    callback set-alternate-modifier(string);
    callback try-palette-shortcut(string, bool, bool, bool, bool, bool) -> bool;
    callback toggle-auto-preview-audio();
    callback toggle-preview-playback();
    callback seek-audio-preview(float);
    callback open-config-file();
    callback reload-settings();
    callback add-library-folders();
    callback remove-library-folder(int);

    public function focus-search() {
        search-input.focus();
        search-input.select-all();
    }

    function begin-recording(target: string) {
        if (root.recording-target == target && root.recording-hotkey) {
            root.set-recording(false);
            return;
        }
        root.recording-target = target;
        root.set-recording(true);
    }

    function set-recording(active: bool) {
        if (!active) {
            root.recording-target = "";
        }
        if (root.recording-hotkey != active) {
            root.recording-hotkey = active;
            root.hotkey-recording-changed(active);
        }
        if (active) {
            if (root.recording-target == "") {
                root.recording-target = "launch";
            }
            root.settings-feedback = "";
            root.settings-feedback-error = false;
            recorder-focus.focus();
        } else if (root.settings-open) {
            settings-focus.focus();
        }
    }

    changed settings-open => {
        if (root.settings-open) {
            if (!root.recording-hotkey) {
                settings-focus.focus();
            }
        } else {
            root.settings-tab-index = 0;
        }
    }

    function select-settings-tab(index: int) {
        if (root.settings-tab-index != index) {
            root.set-recording(false);
            root.settings-tab-index = index;
            settings-focus.focus();
        }
    }

    function is-alternate-modifier(mods: KeyboardModifiers) -> bool {
        return root.alternate-modifier == "ctrl" ? mods.control
            : root.alternate-modifier == "alt" ? mods.alt
            : mods.shift;
    }

    function switch-catalog() {
        root.select-catalog(root.active-catalog == "all" ? "effects"
            : root.active-catalog == "effects" ? "project"
            : root.active-catalog == "project" ? "library"
            : root.active-catalog == "library" ? "actions" : "all");
    }

    function select-catalog(catalog: string) {
        if (root.active-catalog != catalog) {
            root.active-catalog = catalog;
            root.catalog-changed();
        }
        search-input.focus();
    }

    // Catch palette navigation and Escape even if the search input is not focused.
    FocusScope {
        width: 100%;
        height: 100%;
        forward-focus: search-input;

        key-pressed(event) => {
            if (root.settings-open) {
                if (event.text == Key.Escape) {
                    if (root.recording-hotkey) {
                        root.set-recording(false);
                    } else {
                        root.toggle-settings();
                    }
                    return accept;
                }
                if (!root.recording-hotkey && root.try-palette-shortcut(
                    event.text,
                    event.modifiers.control,
                    event.modifiers.alt,
                    event.modifiers.shift,
                    event.modifiers.meta,
                    event.repeat,
                )) {
                    return accept;
                }
                if (event.text == Key.F12 && !root.recording-hotkey) {
                    root.toggle-debug-log();
                    return accept;
                }
                if (!root.recording-hotkey && !event.modifiers.control && !event.modifiers.alt
                    && !event.modifiers.shift && !event.modifiers.meta
                    && (event.text == Key.LeftArrow || event.text == Key.RightArrow)) {
                    root.select-settings-tab((root.settings-tab-index + (event.text == Key.LeftArrow ? -1 : 1)).clamp(0, 4));
                    return accept;
                }
                return reject;
            }
            if (root.try-palette-shortcut(
                event.text,
                event.modifiers.control,
                event.modifiers.alt,
                event.modifiers.shift,
                event.modifiers.meta,
                event.repeat,
            )) {
                return accept;
            }
            if (event.text == Key.Return && root.is-alternate-modifier(event.modifiers)) {
                root.shift-activate-selected();
                return accept;
            }
            if (event.text == Key.Backspace && root.search-text == "" && root.active-bin != "") {
                root.step-out-bin();
                return accept;
            }
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.move-selection(-1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.move-selection(1);
                return accept;
            }
            if (event.text == Key.Tab) {
                root.switch-catalog();
                return accept;
            }
            if (event.text == Key.F12) {
                root.toggle-debug-log();
                return accept;
            }
            return reject;
        }

        // Outer bordered shell
        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.window-background;
            border-radius: 10px;
            clip: true;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Search bar or Settings header
            Rectangle {
                height: 48px;
                background: Theme.header-background;

                HorizontalLayout {
                    visible: root.settings-open;
                    width: 100%;
                    height: 100%;
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 12px;
                    alignment: stretch;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: "Settings";
                            font-size: 15px;
                            font-weight: 600;
                            color: Theme.primary-text;
                        }
                        Text {
                            text: "Changes save as you make them";
                            font-size: 11px;
                            color: Theme.muted-text;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 64px;
                            height: 26px;
                            border-radius: 6px;
                            background: back-touch.has-hover ? Theme.control-hover : transparent;
                            border-width: 1px;
                            border-color: Theme.card-border;
                            accessible-role: button;
                            accessible-label: "Back to search";
                            accessible-action-default => { root.toggle-settings(); }
                            Text {
                                text: "Done";
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.result-text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            back-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-settings(); }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    visible: !root.settings-open;
                    y: 0px;
                    width: 100%;
                    height: 100%;
                    padding-left: 16px;
                    padding-right: 14px;
                    spacing: 10px;
                    alignment: stretch;

                    VerticalLayout {
                        alignment: center;
                        Icon {
                            name: "search";
                            ink: Theme.placeholder-text;
                            width: 17px;
                            height: 17px;
                        }
                    }

                    if root.active-bin != "" : VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 24px;
                            width: min(bin-content.preferred-width, 220px);
                            border-radius: 6px;
                            background: bin-touch.has-hover ? Theme.project-hover : Theme.project-tint;
                            accessible-role: button;
                            accessible-label: "Inside bin " + root.active-bin + ". Step up one level";
                            accessible-action-default => { root.step-out-bin(); }
                            bin-content := HorizontalLayout {
                                padding-left: 7px;
                                padding-right: 7px;
                                spacing: 5px;
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        name: "folder";
                                        ink: Theme.project-accent;
                                        width: 13px;
                                        height: 13px;
                                    }
                                }
                                Text {
                                    text: root.active-bin;
                                    font-size: 11.5px;
                                    font-weight: 600;
                                    color: Theme.project-emphasis;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: "×";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: Theme.project-accent;
                                    vertical-alignment: center;
                                }
                            }
                            bin-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.step-out-bin(); }
                            }
                            Tooltip {
                                text: @markdown("\{root.active-bin} (Backspace or click to go up)");
                            }
                        }
                    }

                    // Input box container
                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;

                        // Placeholder text when empty
                        if root.search-text == "" : Text {
                            x: 0px;
                            width: 100%;
                            height: 100%;
                            text: root.marker-naming ? "Name the marker"
                                : root.marker-picker ? "Search markers"
                                : root.active-bin != "" ? "Search this bin"
                                : root.active-catalog == "effects" ? "Search effects and transitions"
                                : root.active-catalog == "project" ? "Search project media"
                                : root.active-catalog == "library" ? "Search files in your Library folders"
                                : root.active-catalog == "actions" ? "Search actions"
                                : "Search effects, media, and actions";
                            color: Theme.placeholder-text;
                            font-size: 15px;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        search-input := TextInput {
                            enabled: !root.settings-open;
                            x: 0px;
                            width: 100%;
                            height: 100%;
                            text <=> root.search-text;
                            font-size: 15px;
                            color: Theme.primary-text;
                            selection-background-color: Theme.text-selection;
                            selection-foreground-color: Theme.text-selection-foreground;
                            vertical-alignment: center;
                            single-line: true;

                            edited => {
                                root.search-edited(self.text);
                            }

                            accepted => {
                                root.activate-selected();
                            }

                            key-pressed(event) => {
                                if (root.try-palette-shortcut(
                                    event.text,
                                    event.modifiers.control,
                                    event.modifiers.alt,
                                    event.modifiers.shift,
                                    event.modifiers.meta,
                                    event.repeat,
                                )) {
                                    return accept;
                                }
                                if (event.text == Key.Return && root.is-alternate-modifier(event.modifiers)) {
                                    root.shift-activate-selected();
                                    return accept;
                                }
                                if (event.text == Key.Backspace && root.search-text == "" && root.active-bin != "") {
                                    root.step-out-bin();
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    root.move-selection(-1);
                                    return accept;
                                }
                                if (event.text == Key.DownArrow) {
                                    root.move-selection(1);
                                    return accept;
                                }
                                if (event.text == Key.Tab) {
                                    root.switch-catalog();
                                    return accept;
                                }
                                if (event.text == Key.F12) {
                                    root.toggle-debug-log();
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }

                    // A reminder of the launch hotkey while the search box is empty.
                    if root.search-text == "" && !root.marker-naming : VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 20px;
                            width: launch-label.preferred-width + 12px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.card-border;
                            launch-label := Text {
                                text: root.hotkey-label;
                                font-size: 10.5px;
                                color: Theme.subtle-text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

            }

            Rectangle {
                height: 1px;
                background: Theme.section-divider;
            }

            // Catalogs as plain text tabs.
            if !root.settings-open : Rectangle {
                height: 34px;
                background: Theme.header-background;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 20px;

                    HorizontalLayout {
                        spacing: 20px;
                        accessible-role: tab-list;
                        accessible-label: "Search catalogs";
                        accessible-item-count: 5;
                        for catalog[index] in [
                            { id: "all", label: "All" },
                            { id: "effects", label: "Effects" },
                            { id: "project", label: "Project" },
                            { id: "library", label: "Library" },
                            { id: "actions", label: "Actions" },
                        ] : TextTab {
                            label: catalog.label;
                            index: index;
                            active: catalog.id == root.active-catalog;
                            clicked => { root.select-catalog(catalog.id); }
                        }
                    }
                }
            }

            if !root.settings-open : Rectangle {
                height: 1px;
                background: Theme.section-divider;
            }

            // Eight visible results (or Settings panel)
            Rectangle {
                min-height: 0px;
                vertical-stretch: 1;
                background: Theme.window-background;
                clip: true;

                // Settings tabs and their content
                Rectangle {
                    visible: root.settings-open;
                    width: 100%;
                    height: 100%;

                    settings-focus := FocusScope {
                        width: 0px;
                        height: 0px;
                        enabled: root.settings-open && !root.recording-hotkey;
                    }

                    recorder-focus := FocusScope {
                        width: 0px;
                        height: 0px;
                        enabled: root.settings-open && root.recording-hotkey;
                        key-pressed(event) => {
                            if (!root.recording-hotkey) {
                                return reject;
                            }
                            if (event.text == Key.Escape) {
                                root.set-recording(false);
                                return accept;
                            }
                            root.capture-shortcut(
                                root.recording-target,
                                event.text,
                                event.modifiers.control,
                                event.modifiers.alt,
                                event.modifiers.shift,
                                event.modifiers.meta,
                            );
                            return accept;
                        }
                    }

                    VerticalLayout {
                        width: 100%;
                        height: 100%;
                        padding: 0px;
                        spacing: 0px;

                        Rectangle {
                            height: 34px;
                            background: Theme.header-background;
                            HorizontalLayout {
                                padding-left: 16px;
                                spacing: 20px;
                                alignment: start;
                                accessible-role: tab-list;
                                accessible-label: "Settings sections";
                                accessible-item-count: 5;

                                for title[index] in ["General", "Hotkeys", "Library", "Appearance", "About"] : TextTab {
                                    label: title;
                                    index: index;
                                    active: index == root.settings-tab-index;
                                    clicked => { root.select-settings-tab(index); }
                                }
                            }
                        }
                        Rectangle {
                            height: 1px;
                            background: Theme.section-divider;
                        }

                        if root.settings-tab-index == 4 : VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            spacing: 6px;

                            Text {
                                text: "Version: " + root.app-version;
                                font-size: 15px;
                                font-weight: 600;
                                color: Theme.selected-tab-text;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Developed by Vee Jay";
                                font-size: 13px;
                                color: Theme.tab-text;
                                horizontal-alignment: center;
                            }

                            HorizontalLayout {
                                alignment: center;

                                AboutSlint {
                                    width: 172px;
                                    height: 110px;
                                }
                            }
                        }

                        if root.settings-tab-index != 4 && root.settings-feedback != "" : Rectangle {
                            background: root.settings-feedback-error ? Theme.error-background : Theme.success-background;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                Text {
                                    text: root.settings-feedback;
                                    font-size: 11px;
                                    color: root.settings-feedback-error ? Theme.error-text : Theme.success-text;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        if root.settings-tab-index == 1 : Flickable {
                            vertical-stretch: 1;
                            interactive: true;
                            content-height: hotkeys-list.preferred-height;

                            hotkeys-list := VerticalLayout {
                                width: 100%;
                                padding: 14px;
                                spacing: 8px;
                                alignment: start;

                                if root.action-hotkeys-warning != "" : Text {
                                    text: root.action-hotkeys-warning;
                                    font-size: 11px;
                                    color: Theme.error-text;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: "Hotkeys work in Premiere and in Spotlight. None are set at first.";
                                    font-size: 11px;
                                    color: Theme.muted-text;
                                    wrap: word-wrap;
                                }

                                // One card with a row per action, separated by hairlines.
                                Rectangle {
                                    background: Theme.header-background;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.card-border;

                                    VerticalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        for action[index] in root.action-hotkeys : VerticalLayout {
                                            if index > 0 : Rectangle {
                                                height: 1px;
                                                background: Theme.section-divider;
                                            }
                                            VerticalLayout {
                                                padding-top: 9px;
                                                padding-bottom: 9px;
                                                ShortcutRecorderRow {
                                                    label: action.label;
                                                    hint: action.hint;
                                                    shortcut-text: action.shortcut;
                                                    empty-text: "Set hotkey";
                                                    recording: root.recording-hotkey && root.recording-target == action.id;
                                                    toggle-record => { root.begin-recording(action.id); }
                                                    clear-clicked => {
                                                        root.set-recording(false);
                                                        root.clear-shortcut(action.id);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if root.settings-tab-index == 2 : Flickable {
                            vertical-stretch: 1;
                            interactive: true;
                            content-height: library-list.preferred-height;

                            library-list := VerticalLayout {
                                width: 100%;
                                padding: 14px;
                                spacing: 8px;
                                alignment: start;

                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: "Library folders";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.primary-text;
                                        }
                                        Text {
                                            text: "Files Premiere can import in these folders show in Library and All.";
                                            font-size: 11px;
                                            color: Theme.muted-text;
                                            wrap: word-wrap;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: add-folder-label.preferred-width + 24px;
                                            height: 26px;
                                            border-radius: 6px;
                                            background: add-folder-touch.has-hover ? Theme.control-hover : Theme.control-background;
                                            border-width: 1px;
                                            border-color: Theme.outline;
                                            accessible-role: button;
                                            accessible-label: "Add Library folders";
                                            accessible-action-default => { root.add-library-folders(); }
                                            add-folder-label := Text {
                                                text: "Add folders…";
                                                font-size: 11px;
                                                font-weight: 600;
                                                color: Theme.control-text;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            add-folder-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.set-recording(false);
                                                    root.add-library-folders();
                                                }
                                            }
                                        }
                                    }
                                }

                                if root.library-folder-count == 0 : Rectangle {
                                    height: 60px;
                                    background: Theme.header-background;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.card-border;
                                    Text {
                                        text: "No folders yet. Add the folders that hold your sound effects, music, memes or images.";
                                        font-size: 11.5px;
                                        color: Theme.subtle-text;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                        width: parent.width - 24px;
                                    }
                                }

                                // One card with a row per folder, separated by hairlines.
                                if root.library-folder-count > 0 : Rectangle {
                                    background: Theme.header-background;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.card-border;

                                    VerticalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        for folder[index] in root.library-folders : VerticalLayout {
                                            if index > 0 : Rectangle {
                                                height: 1px;
                                                background: Theme.section-divider;
                                            }
                                            HorizontalLayout {
                                                padding-top: 9px;
                                                padding-bottom: 9px;
                                                spacing: 10px;
                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: center;
                                                    spacing: 2px;
                                                    Text {
                                                        text: folder.path;
                                                        font-size: 12px;
                                                        font-weight: 600;
                                                        color: Theme.primary-text;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: folder.detail;
                                                        font-size: 11px;
                                                        color: folder.detail == "Folder not found" ? Theme.error-text : Theme.muted-text;
                                                        overflow: elide;
                                                    }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 26px;
                                                        height: 26px;
                                                        border-radius: 6px;
                                                        background: remove-touch.has-hover ? Theme.danger-hover : Theme.control-background;
                                                        border-width: 1px;
                                                        border-color: remove-touch.has-hover ? Theme.danger-outline : Theme.outline;
                                                        accessible-role: button;
                                                        accessible-label: "Remove " + folder.path;
                                                        accessible-action-default => { root.remove-library-folder(index); }
                                                        Text {
                                                            text: "×";
                                                            font-size: 13px;
                                                            font-weight: 700;
                                                            color: Theme.control-text;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                        }
                                                        remove-touch := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.set-recording(false);
                                                                root.remove-library-folder(index);
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if root.settings-tab-index == 3 : VerticalLayout {
                            vertical-stretch: 1;
                            alignment: start;
                            padding: 14px;

                            Rectangle {
                                height: 60px;
                                background: Theme.header-background;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.card-border;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;

                                    Text {
                                        text: "Theme";
                                        color: Theme.primary-text;
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        width: 172px;

                                        ComboBox {
                                            accessible-label: "Theme";
                                            model: root.theme-options;
                                            current-index <=> root.theme-selection;
                                            selected(value) => {
                                                root.select-theme(value);
                                                // The widget tracks the value and index separately.
                                                self.current-value = root.theme-name;
                                                root.theme-selection = root.saved-theme-index;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if root.settings-tab-index == 0 : Flickable {
                            vertical-stretch: 1;
                            content-height: settings-list.preferred-height;
                            interactive: true;

                            settings-list := VerticalLayout {
                                width: 100%;
                                padding: 14px;
                                spacing: 10px;
                                alignment: start;

                                // Card 1: Launch Hotkey
                                Rectangle {
                                    background: Theme.header-background;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.card-border;

                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 8px;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: stretch;

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "Launch hotkey";
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    color: Theme.primary-text;
                                                }
                                                Text {
                                                    text: "Opens Spotlight while Premiere Pro is in front";
                                                    font-size: 11px;
                                                    color: Theme.muted-text;
                                                    overflow: elide;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: center;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        min-width: 122px;
                                                        height: 28px;
                                                        border-radius: 6px;
                                                        background: (root.recording-hotkey && root.recording-target == "launch") ? Theme.accent-tint
                                                            : (record-touch.has-hover ? Theme.shortcut-hover : Theme.shortcut-background);
                                                        border-width: 1px;
                                                        border-color: (root.recording-hotkey && root.recording-target == "launch") ? Theme.focus-outline : Theme.shortcut-border;
                                                        accessible-role: button;
                                                        accessible-label: "Change launch hotkey";
                                                        accessible-action-default => { root.begin-recording("launch"); }

                                                        HorizontalLayout {
                                                            padding-left: 10px;
                                                            padding-right: 10px;
                                                            alignment: center;
                                                            Text {
                                                                text: (root.recording-hotkey && root.recording-target == "launch") ? "Press keys…" : root.hotkey-label;
                                                                font-size: 11.5px;
                                                                font-weight: 700;
                                                                color: (root.recording-hotkey && root.recording-target == "launch") ? Theme.accent-text : Theme.shortcut-text;
                                                                horizontal-alignment: center;
                                                                vertical-alignment: center;
                                                            }
                                                        }

                                                        record-touch := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.begin-recording("launch"); }
                                                        }
                                                        Tooltip {
                                                            text: @markdown("Click then press a new key combination (Esc to cancel)");
                                                        }
                                                    }
                                                }

                                                if root.hotkey-label != root.default-hotkey : VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 52px;
                                                        height: 28px;
                                                        border-radius: 6px;
                                                        background: reset-touch.has-hover ? Theme.control-hover : Theme.control-background;
                                                        border-width: 1px;
                                                        border-color: Theme.outline;
                                                        accessible-role: button;
                                                        accessible-label: "Reset hotkey to " + root.default-hotkey;
                                                        accessible-action-default => { root.reset-default-hotkey(); }
                                                        Text {
                                                            text: "Reset";
                                                            font-size: 11px;
                                                            font-weight: 600;
                                                            color: Theme.control-text;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                        }
                                                        reset-touch := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.set-recording(false);
                                                                root.reset-default-hotkey();
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Card 2: Effect Controls on Enter
                                Rectangle {
                                    background: Theme.header-background;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.card-border;

                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 12px;
                                        alignment: stretch;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: "Open Effect Controls on Enter";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: Theme.primary-text;
                                            }
                                            Text {
                                                text: root.open-effect-controls-default
                                                    ? "Enter applies and opens Effect Controls. " + root.alternate-modifier-label + "+Enter only applies."
                                                    : "Enter only applies. " + root.alternate-modifier-label + "+Enter also opens Effect Controls.";
                                                font-size: 11px;
                                                color: Theme.muted-text;
                                                overflow: elide;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            SettingsToggle {
                                                checked: root.open-effect-controls-default;
                                                label: "Open Effect Controls on Enter";
                                                toggled => {
                                                    root.set-recording(false);
                                                    root.toggle-default-effect-controls();
                                                }
                                            }
                                        }
                                    }
                                }

                                // Card 3: Alternate Action Modifier
                                Rectangle {
                                    background: Theme.header-background;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.card-border;

                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 12px;
                                        alignment: stretch;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: "Alternate action key";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: Theme.primary-text;
                                            }
                                            Text {
                                                text: "Hold with Enter or a click for the second action of a result";
                                                font-size: 11px;
                                                color: Theme.muted-text;
                                                overflow: elide;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 4px;
                                            alignment: center;

                                            for opt in [
                                                { id: "shift", title: "Shift" },
                                                { id: "ctrl", title: "Ctrl" },
                                                { id: "alt", title: "Alt" },
                                            ] : VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 44px;
                                                    height: 26px;
                                                    border-radius: 5px;
                                                    background: root.alternate-modifier == opt.id ? Theme.accent-tint
                                                        : (mod-touch.has-hover ? Theme.control-hover : Theme.control-background);
                                                    border-width: 1px;
                                                    border-color: root.alternate-modifier == opt.id ? Theme.focus-outline : Theme.outline;
                                                    Text {
                                                        text: opt.title;
                                                        font-size: 11px;
                                                        font-weight: root.alternate-modifier == opt.id ? 700 : 500;
                                                        color: root.alternate-modifier == opt.id ? Theme.accent-text : Theme.control-text;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    mod-touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.set-recording(false);
                                                            root.set-alternate-modifier(opt.id);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Card 4: Open Settings Shortcut
                                Rectangle {
                                    background: Theme.header-background;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.card-border;

                                    VerticalLayout {
                                        padding: 12px;
                                        ShortcutRecorderRow {
                                            label: "Open settings";
                                            hint: "Works inside Spotlight";
                                            shortcut-text: root.settings-hotkey-label;
                                            recording: root.recording-hotkey && root.recording-target == "settings";
                                            toggle-record => { root.begin-recording("settings"); }
                                            clear-clicked => {
                                                root.set-recording(false);
                                                root.clear-shortcut("settings");
                                            }
                                        }
                                    }
                                }

                                // Card 5: Direct Catalog Shortcuts
                                Rectangle {
                                    background: Theme.header-background;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.card-border;

                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 8px;

                                        VerticalLayout {
                                            spacing: 2px;
                                            Text {
                                                text: "Catalog shortcuts";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: Theme.primary-text;
                                            }
                                            Text {
                                                text: "Optional. Jump straight to a catalog while Spotlight is open.";
                                                font-size: 11px;
                                                color: Theme.muted-text;
                                                overflow: elide;
                                            }
                                        }

                                        ShortcutRecorderRow {
                                            label: "All";
                                            shortcut-text: root.catalog-all-hotkey-label;
                                            recording: root.recording-hotkey && root.recording-target == "catalog_all";
                                            toggle-record => { root.begin-recording("catalog_all"); }
                                            clear-clicked => {
                                                root.set-recording(false);
                                                root.clear-shortcut("catalog_all");
                                            }
                                        }

                                        ShortcutRecorderRow {
                                            label: "Effects";
                                            shortcut-text: root.catalog-effects-hotkey-label;
                                            recording: root.recording-hotkey && root.recording-target == "catalog_effects";
                                            toggle-record => { root.begin-recording("catalog_effects"); }
                                            clear-clicked => {
                                                root.set-recording(false);
                                                root.clear-shortcut("catalog_effects");
                                            }
                                        }

                                        ShortcutRecorderRow {
                                            label: "Project";
                                            shortcut-text: root.catalog-project-hotkey-label;
                                            recording: root.recording-hotkey && root.recording-target == "catalog_project";
                                            toggle-record => { root.begin-recording("catalog_project"); }
                                            clear-clicked => {
                                                root.set-recording(false);
                                                root.clear-shortcut("catalog_project");
                                            }
                                        }

                                        ShortcutRecorderRow {
                                            label: "Library";
                                            shortcut-text: root.catalog-library-hotkey-label;
                                            recording: root.recording-hotkey && root.recording-target == "catalog_library";
                                            toggle-record => { root.begin-recording("catalog_library"); }
                                            clear-clicked => {
                                                root.set-recording(false);
                                                root.clear-shortcut("catalog_library");
                                            }
                                        }

                                        ShortcutRecorderRow {
                                            label: "Actions";
                                            shortcut-text: root.catalog-actions-hotkey-label;
                                            recording: root.recording-hotkey && root.recording-target == "catalog_actions";
                                            toggle-record => { root.begin-recording("catalog_actions"); }
                                            clear-clicked => {
                                                root.set-recording(false);
                                                root.clear-shortcut("catalog_actions");
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    background: Theme.header-background;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.card-border;

                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 8px;

                                        ShortcutRecorderRow {
                                            label: "Preview audio";
                                            shortcut-text: root.audio-preview-hotkey-label;
                                            recording: root.recording-hotkey && root.recording-target == "audio_preview";
                                            toggle-record => { root.begin-recording("audio_preview"); }
                                            clear-clicked => {
                                                root.set-recording(false);
                                                root.clear-shortcut("audio_preview");
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: "Auto-preview audio";
                                                font-size: 12px;
                                                color: Theme.primary-text;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                            SettingsToggle {
                                                checked: root.auto-preview-audio;
                                                label: "Auto-preview audio";
                                                toggled => {
                                                    root.set-recording(false);
                                                    root.toggle-auto-preview-audio();
                                                }
                                            }
                                        }
                                    }
                                }

                                // Config file location & actions
                                Rectangle {
                                    background: Theme.header-background;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.card-border;

                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 10px;
                                        alignment: stretch;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: "Settings file";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: Theme.primary-text;
                                            }
                                            Text {
                                                text: root.config-path-display;
                                                font-size: 10.5px;
                                                font-family: "Consolas";
                                                color: Theme.muted-text;
                                                overflow: elide;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: center;

                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 72px;
                                                    height: 26px;
                                                    border-radius: 6px;
                                                    background: open-cfg-touch.has-hover ? Theme.control-hover : Theme.control-background;
                                                    border-width: 1px;
                                                    border-color: Theme.outline;
                                                    accessible-role: button;
                                                    accessible-label: "Open config file";
                                                    accessible-action-default => { root.open-config-file(); }
                                                    Text {
                                                        text: "Open";
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        color: Theme.control-text;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    open-cfg-touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.set-recording(false);
                                                            root.open-config-file();
                                                        }
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 58px;
                                                    height: 26px;
                                                    border-radius: 6px;
                                                    background: reload-cfg-touch.has-hover ? Theme.control-hover : Theme.control-background;
                                                    border-width: 1px;
                                                    border-color: Theme.outline;
                                                    accessible-role: button;
                                                    accessible-label: "Reload config file";
                                                    accessible-action-default => { root.reload-settings(); }
                                                    Text {
                                                        text: "Reload";
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        color: Theme.control-text;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    reload-cfg-touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.set-recording(false);
                                                            root.reload-settings();
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if !root.settings-open && root.results.length == 0 : VerticalLayout {
                    alignment: center;
                    padding-left: 40px;
                    padding-right: 40px;
                    Text {
                        text: root.marker-naming ? (root.search-text == ""
                                ? "Type a name, then press Enter to add a marker at the playhead"
                                : "Press Enter to add \u{201c}" + root.search-text + "\u{201d} at the playhead")
                            : root.marker-picker && root.marker-status != "" ? root.marker-status
                            : root.active-bin != "" && root.search-text == "" ? "This bin is empty"
                            : root.show-recent-items ? "Effects and media you use show up here"
                            : root.show-project-loading ? "Loading project media…"
                            : root.active-catalog == "library" && root.library-folder-count == 0
                                ? "Add folders in Settings › Library to search their files"
                            : "No matches. Try another word, or press Tab to switch catalogs.";
                        font-size: 13px;
                        color: Theme.subtle-text;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                VerticalLayout {
                    visible: !root.settings-open;
                    width: 100%;
                    height: 100%;
                    padding-left: 6px;
                    padding-right: 6px;
                    padding-top: 4px;
                    spacing: 2px;
                    alignment: start;

                    if root.show-recent-items && root.results.length > 0 : HorizontalLayout {
                        height: 20px;
                        padding-left: 10px;
                        Text {
                            text: "Recent";
                            font-size: 11px;
                            color: Theme.subtle-text;
                            vertical-alignment: center;
                        }
                    }

                    for item[idx] in root.results : result-row := Rectangle {
                        // The highlighted row grows a second line for its subtitle.
                        property <bool> selected: idx == root.selected-index;
                        property <bool> show-subtitle: self.selected && item.subtitle != "";
                        height: self.show-subtitle ? 48px : 34px;
                        border-radius: 7px;
                        clip: true;
                        background: self.selected ? Theme.row-selected : (row-touch.has-hover ? Theme.row-hover : transparent);
                        border-width: self.selected || idx == root.flash-row ? 1px : 0px;
                        border-color: idx == root.flash-row ? Theme.warning : Theme.row-outline;
                        animate border-color { duration: 120ms; }
                        accessible-role: list-item;
                        accessible-label: (item.disabled ? item.name + ", unavailable: " + item.subtitle : item.name)
                            + (item.needs-import ? ", not in the project yet" : "");

                        row-touch := TouchArea {
                            property <bool> shift-click;
                            mouse-cursor: pointer;
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down) {
                                    self.shift-click = root.is-alternate-modifier(event.modifiers);
                                }
                            }
                            clicked => {
                                if (self.shift-click) {
                                    root.shift-activate-index(idx);
                                } else {
                                    root.activate-index(idx);
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 10px;
                            spacing: 10px;

                            // The kind of result, as a tinted icon.
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    border-radius: 7px;
                                    background: item.tint.with-alpha((Theme.light ? 0.32 : 0.14) * (item.disabled ? 0.5 : 1));
                                    Icon {
                                        x: 5px;
                                        y: 5px;
                                        width: 16px;
                                        height: 16px;
                                        name: item.icon;
                                        ink: item.disabled ? Theme.subtle-text
                                            : (Theme.light ? item.ink : item.tint);
                                    }
                                    // A Library file outside the project: an arrow into it.
                                    if item.needs-import : Rectangle {
                                        x: parent.width - 9px;
                                        y: parent.height - 9px;
                                        width: 13px;
                                        height: 13px;
                                        border-radius: 6.5px;
                                        background: item.disabled ? Theme.subtle-text : Theme.warning;
                                        border-width: 2px;
                                        // Cut out of the row behind it, so the badge reads as separate.
                                        border-color: result-row.selected ? Theme.row-selected
                                            : (row-touch.has-hover ? Theme.row-hover : Theme.window-background);
                                        Path {
                                            x: 2px;
                                            y: 2px;
                                            width: 9px;
                                            height: 9px;
                                            viewbox-width: 10;
                                            viewbox-height: 10;
                                            stroke: Theme.window-background;
                                            stroke-width: 1.6px;
                                            stroke-line-cap: round;
                                            stroke-line-join: round;
                                            fill: transparent;
                                            commands: "M5 1.8v5M2.8 4.8L5 7l2.2-2.2";
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: item.name;
                                    font-size: 13px;
                                    font-weight: result-row.selected ? 600 : 400;
                                    color: item.disabled ? Theme.subtle-text
                                        : (result-row.selected ? Theme.row-selected-text : Theme.result-text);
                                    overflow: elide;
                                }
                                if result-row.show-subtitle : HorizontalLayout {
                                    spacing: 5px;
                                    if item.disabled : VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            name: "info";
                                            ink: Theme.warning;
                                            width: 12px;
                                            height: 12px;
                                        }
                                    }
                                    Text {
                                        text: item.subtitle;
                                        font-size: 11px;
                                        color: item.disabled ? Theme.warning : Theme.muted-text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            if item.detail != "" : Text {
                                min-width: 0px;
                                max-width: 210px;
                                text: item.detail;
                                font-size: 11px;
                                color: Theme.subtle-text;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            if root.preview-active && idx == root.selected-index : VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 32px;
                                    height: 24px;
                                    border-radius: 5px;
                                    background: playback-button.has-hover ? Theme.accent-hover : transparent;
                                    accessible-role: button;
                                    accessible-label: !root.preview-can-toggle ? "Loading audio preview"
                                        : root.preview-playing ? "Pause audio preview" : "Play audio preview";
                                    accessible-enabled: root.preview-can-toggle;
                                    accessible-action-default => {
                                        if root.preview-can-toggle { root.toggle-preview-playback(); }
                                    }
                                    Path {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 12px;
                                        height: 12px;
                                        viewbox-width: 12;
                                        viewbox-height: 12;
                                        fill: root.preview-can-toggle ? Theme.accent-text : Theme.preview-disabled;
                                        commands: root.preview-playing
                                            ? "M2 1 H5 V11 H2 Z M7 1 H10 V11 H7 Z"
                                            : "M2 1 L11 6 L2 11 Z";
                                    }
                                    playback-button := TouchArea {
                                        mouse-cursor: root.preview-can-toggle ? MouseCursor.pointer : MouseCursor.default;
                                        clicked => {
                                            if root.preview-can-toggle { root.toggle-preview-playback(); }
                                        }
                                    }
                                }
                            }

                        }

                        if root.preview-active && idx == root.selected-index && root.preview-can-seek : Rectangle {
                            x: 0px;
                            y: parent.height - self.height - 1px;
                            width: parent.width;
                            height: 8px;
                            accessible-role: slider;
                            accessible-label: "Audio preview position";
                            accessible-value: root.preview-progress;
                            accessible-value-minimum: 0;
                            accessible-value-maximum: 1;
                            accessible-action-increment => {
                                root.seek-audio-preview(min(1, root.preview-progress + 0.05));
                            }
                            accessible-action-decrement => {
                                root.seek-audio-preview(max(0, root.preview-progress - 0.05));
                            }
                            accessible-action-set-value(value) => {
                                if value.is-float() { root.seek-audio-preview(value.to-float()); }
                            }

                            progress-track := Rectangle {
                                x: result-row.border-radius;
                                y: parent.height - self.height;
                                width: parent.width - 2 * self.x;
                                height: 2px;
                                border-radius: 1px;
                                background: Theme.progress-track;
                                Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width * root.preview-progress;
                                    height: parent.height;
                                    border-radius: parent.border-radius;
                                    background: Theme.progress-fill;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.seek-audio-preview(((self.mouse-x - progress-track.x) / progress-track.width).clamp(0, 1));
                                }
                            }
                            Tooltip {
                                text: @markdown("\{root.preview-time}");
                            }
                        }
                    }
                }
            }

            // Divider
            Rectangle {
                height: 1px;
                background: Theme.footer-divider;
            }

            // Footer: what the keys do for the highlighted row, or a short message in their place.
            Rectangle {
                height: 34px;
                background: Theme.strip-background;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 14px;
                    padding-right: 10px;
                    spacing: 14px;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 3.5px;
                            background: root.bridge-connected ? Theme.connected : Theme.warning;
                            accessible-role: text;
                            accessible-label: root.bridge-connected ? "Connected to Premiere" : "Not connected to Premiere";
                        }
                    }

                    if root.footer-message != "" : Text {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        text: root.footer-message;
                        font-size: 11.5px;
                        color: Theme.muted-text;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.footer-message == "" : HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 16px;
                        alignment: start;
                        if !root.settings-open && root.hint-enter != "" : KeyHint {
                            key: "Enter";
                            label: root.hint-enter;
                        }
                        if !root.settings-open && root.hint-alternate != "" : KeyHint {
                            key: root.alternate-modifier-label + "+Enter";
                            label: root.hint-alternate;
                        }
                        if !root.settings-open && !root.marker-picker && !root.marker-naming : KeyHint {
                            key: "Tab";
                            label: "Catalogs";
                        }
                        KeyHint {
                            key: "Esc";
                            label: root.settings-open ? "Back" : root.hint-escape;
                        }
                    }

                    // Lower-right Settings gear button
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 5px;
                            background: root.settings-open ? Theme.accent-hover
                                : (gear-touch.has-hover ? Theme.shortcut-hover : transparent);
                            border-width: root.settings-open ? 1px : 0px;
                            border-color: Theme.focus-outline-soft;
                            accessible-role: button;
                            accessible-label: root.settings-open ? "Close settings" : "Open settings";
                            accessible-action-default => { root.toggle-settings(); }

                            Path {
                                x: 5px;
                                y: 5px;
                                width: 14px;
                                height: 14px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                fill: root.settings-open ? Theme.accent-text
                                    : (gear-touch.has-hover ? Theme.result-text : Theme.muted-text);
                                commands: "M19.14 12.94c.04-.31.06-.63.06-.94s-.02-.63-.06-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96a7.03 7.03 0 0 0-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.44.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.74 8.87a.48.48 0 0 0 .12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.49.38 1.03.7 1.62.94l.36 2.54c.03.24.23.41.47.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.48.48 0 0 0-.12-.61l-2.01-1.58z";
                            }
                            Rectangle {
                                x: 9.5px;
                                y: 9.5px;
                                width: 5px;
                                height: 5px;
                                border-radius: 2.5px;
                                background: root.settings-open ? Theme.settings-icon-center : (gear-touch.has-hover ? Theme.shortcut-hover : Theme.strip-background);
                            }

                            gear-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-settings(); }
                            }
                            Tooltip {
                                text: @markdown("\{root.gear-tooltip}");
                            }
                        }
                    }

                }
            }
        }
        }
    }

    // Draw the outline over the content at the native window edge.
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        border-width: 1.5px;
        border-color: Theme.outline;
        border-radius: 10px;
    }
}
