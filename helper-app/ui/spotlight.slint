import { AboutSlint, ComboBox, Palette } from "std-widgets.slint";
import { PaletteThemeColors as Theme } from "palette-theme.slint";

export struct EffectItemUI {
    name: string,
    category: string,
    folder: string,
    badge-bg: color,
    badge-fg: color,
}

export struct DebugLogEntryUI {
    text: string,
    color: color,
}

component DebugMetric inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <color> accent;

    background: #1a1c28;
    border-radius: 5px;
    border-width: 1px;
    border-color: #25283a;

    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 2px;

        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 700;
            font-family: "Consolas";
            color: root.accent;
            overflow: elide;
        }
        Text {
            text: root.hint;
            font-size: 9.5px;
            color: #8b90aa;
            overflow: elide;
        }
    }
}

export component DebugLogWindow inherits Window {
    title: "Premiere Spotlight Debug Log";
    no-frame: true;
    always-on-top: true;
    width: panel-width;
    height: panel-height;
    background: #12131a;

    out property <length> panel-width: 560px;
    out property <length> panel-height: 410px;
    in property <string> ui-timer-rate: "0/s";
    in property <string> ws-poll-rate: "0/s";
    in property <string> fg-hook-rate: "0/s";
    in property <string> last-search-text: "—";
    in property <string> last-rtt-text: "—";
    in property <bool> paused: false;
    in property <[DebugLogEntryUI]> log-entries: [];

    callback clear-requested();
    callback toggle-pause();
    callback close-requested();

    Rectangle {
        width: 100%;
        height: 100%;
        background: #12131a;
        border-width: 1px;
        border-color: #363952;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Header bar
            Rectangle {
                height: 38px;
                background: #171822;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: stretch;

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: "Spotlight Debug & Performance Log";
                            font-size: 12px;
                            font-weight: 700;
                            color: #f3f4f8;
                        }
                    }

                    // Pause / Resume button
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 60px;
                            height: 22px;
                            border-radius: 4px;
                            background: pause-touch.has-hover ? #282b3d : #1f2130;
                            border-width: 1px;
                            border-color: root.paused ? #f59e0b88 : #363952;
                            Text {
                                text: root.paused ? "Resume" : "Pause";
                                font-size: 10px;
                                font-weight: 600;
                                color: root.paused ? #fcd34d : #cbd5e1;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            pause-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-pause(); }
                            }
                        }
                    }

                    // Clear button
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 48px;
                            height: 22px;
                            border-radius: 4px;
                            background: clear-touch.has-hover ? #282b3d : #1f2130;
                            border-width: 1px;
                            border-color: #363952;
                            Text {
                                text: "Clear";
                                font-size: 10px;
                                font-weight: 600;
                                color: #cbd5e1;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            clear-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.clear-requested(); }
                            }
                        }
                    }

                    // Close button
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 48px;
                            height: 22px;
                            border-radius: 4px;
                            background: close-touch.has-hover ? #452730 : #1f2130;
                            border-width: 1px;
                            border-color: close-touch.has-hover ? #ca7c85 : #363952;
                            Text {
                                text: "Close";
                                font-size: 10px;
                                font-weight: 600;
                                color: #f8fafc;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            close-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.close-requested(); }
                            }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: #26283a; }

            // Live metrics bar
            Rectangle {
                background: #151620;

                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 6px;
                        DebugMetric {
                            horizontal-stretch: 1;
                            label: "UI Timer: " + root.ui-timer-rate;
                            hint: "Idle UI wakeups (0/s best)";
                            accent: #fbbf24;
                        }
                        DebugMetric {
                            horizontal-stretch: 1;
                            label: "WS Polls: " + root.ws-poll-rate;
                            hint: "Empty bridge checks (0/s best)";
                            accent: #fbbf24;
                        }
                        DebugMetric {
                            horizontal-stretch: 1;
                            label: "FG Hooks: " + root.fg-hook-rate;
                            hint: "App focus switches (0/s hidden)";
                            accent: #93c5fd;
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        DebugMetric {
                            horizontal-stretch: 1;
                            label: "Last Search: " + root.last-search-text;
                            hint: "Filter speed (matches / total items)";
                            accent: #c4b5fd;
                        }
                        DebugMetric {
                            horizontal-stretch: 1;
                            label: "Bridge RTT: " + root.last-rtt-text;
                            hint: "Premiere action round-trip time";
                            accent: #6ee7b7;
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: #26283a; }

            // Scrollable log list
            Rectangle {
                vertical-stretch: 1;
                background: #0f1017;
                clip: true;

                if root.log-entries.length == 0 : VerticalLayout {
                    alignment: center;
                    Text {
                        text: "No debug events recorded yet";
                        font-size: 11px;
                        font-family: "Consolas";
                        color: #6b708b;
                        horizontal-alignment: center;
                    }
                }

                Flickable {
                    width: 100%;
                    height: 100%;
                    content-height: log-list.preferred-height;
                    interactive: true;

                    log-list := VerticalLayout {
                        width: 100%;
                        padding: 8px;
                        spacing: 3px;
                        alignment: start;

                        for entry in root.log-entries : Text {
                            text: entry.text;
                            font-size: 11px;
                            font-family: "Consolas";
                            color: entry.color;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}

export component ErrorToastWindow inherits Window {
    title: "Premiere Spotlight error";
    no-frame: true;
    always-on-top: true;
    width: 304px;
    height: toast-height;
    background: #242427;

    out property <length> toast-height: 54px;
    in property <string> message;

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-width: 1px;
        border-color: #604249;

        Rectangle {
            x: 12px;
            y: (parent.height - self.height) / 2;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: #ca7c85;
        }

        Text {
            x: 26px;
            y: 4px;
            width: parent.width - 38px;
            height: parent.height - 8px;
            text: root.message;
            font-size: 13px;
            color: #e2e2e5;
            vertical-alignment: center;
            wrap: word-wrap;
            overflow: elide;
        }
    }
}

component ShortcutRecorderRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint: "";
    in property <string> shortcut-text;
    in property <string> empty-text: "Not set";
    in property <bool> recording: false;
    in property <bool> show-clear: true;
    callback toggle-record();
    callback clear-clicked();

    spacing: 10px;
    alignment: stretch;

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.label;
            font-size: 12.5px;
            font-weight: 600;
            color: Theme.primary-text;
        }
        if root.hint != "" : Text {
            text: root.hint;
            font-size: 11px;
            color: Theme.muted-text;
            overflow: elide;
        }
    }

    HorizontalLayout {
        spacing: 6px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            Rectangle {
                min-width: 112px;
                height: 26px;
                border-radius: 6px;
                background: root.recording ? Theme.accent-tint : (slot-touch.has-hover ? Theme.shortcut-hover : Theme.shortcut-background);
                border-width: 1px;
                border-color: root.recording ? Theme.focus-outline : Theme.shortcut-border;
                accessible-role: button;
                accessible-label: root.label;
                accessible-action-default => { root.toggle-record(); }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: center;
                    Text {
                        text: root.recording ? "Press keys…"
                            : (root.shortcut-text != "" ? root.shortcut-text : root.empty-text);
                        font-size: 11px;
                        font-weight: 700;
                        color: root.recording ? Theme.accent-text
                            : (root.shortcut-text != "" ? Theme.shortcut-text : Theme.subtle-text);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                slot-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle-record(); }
                }
            }
        }

        if root.show-clear && root.shortcut-text != "" : VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 6px;
                background: clear-touch.has-hover ? Theme.danger-hover : Theme.control-background;
                border-width: 1px;
                border-color: clear-touch.has-hover ? Theme.danger-outline : Theme.outline;
                accessible-role: button;
                accessible-label: "Clear " + root.label;
                accessible-action-default => { root.clear-clicked(); }
                Text {
                    text: "×";
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.control-text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                clear-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.clear-clicked(); }
                }
            }
        }
    }
}

component SettingsToggle inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    callback toggled();

    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: checked ? Theme.accent : Theme.switch-off;
    border-width: 1px;
    border-color: checked ? Theme.focus-outline : Theme.shortcut-border;
    accessible-role: checkbox;
    accessible-label: label;
    accessible-checked: checked;
    accessible-action-default => { root.toggled(); }

    Rectangle {
        x: root.checked ? 20px : 3px;
        y: 3px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.switch-knob;
        animate x { duration: 120ms; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

export component SpotlightWindow inherits Window {
    title: "";
    no-frame: true;
    always-on-top: true;
    width: 620px;
    height: 440px;
    background: Theme.window-background;

    in-out property <string> theme-name <=> Theme.theme-name;
    out property <color> caption-color: Theme.header-background;
    private property <[string]> theme-options: ["Light", "Dark", "Midnight Indigo", "Premiere"];
    private property <int> saved-theme-index: Theme.light ? 0 : (Theme.indigo ? 2 : (root.theme-name == "Dark" ? 1 : 3));
    private property <int> theme-selection: root.saved-theme-index;
    callback select-theme(string);

    function sync-theme() {
        Palette.color-scheme = Theme.light ? ColorScheme.light : ColorScheme.dark;
        root.theme-selection = root.saved-theme-index;
    }

    init => { root.sync-theme(); }
    changed theme-name => { root.sync-theme(); }

    in property <string> app-version;
    in-out property <string> search-text: "";
    in-out property <int> selected-index: 0;
    in-out property <string> active-catalog: "all";
    in-out property <string> active-bin: "";
    in property <bool> show-recent-items: false;
    in-out property <bool> bridge-connected: false;
    in-out property <int> total-matches: 0;
    private property <string> gear-tooltip: settings-open ? "Back to Search"
        : (settings-hotkey-label != "" ? "Settings (" + settings-hotkey-label + ")" : "Settings");
    in-out property <string> hotkey-label: "Ctrl+Space";
    in-out property <string> status-message: "Ready · " + root.hotkey-label;
    in-out property <bool> settings-open: false;
    private property <int> settings-tab-index: 0;
    in-out property <bool> recording-hotkey: false;
    in-out property <string> recording-target: "";
    in-out property <bool> open-effect-controls-default: false;
    in-out property <string> alternate-modifier: "shift";
    private property <string> alternate-modifier-label: alternate-modifier == "ctrl" ? "Ctrl"
        : alternate-modifier == "alt" ? "Alt" : "Shift";
    in-out property <string> settings-hotkey-label: "Ctrl+,";
    in-out property <string> catalog-all-hotkey-label: "";
    in-out property <string> catalog-effects-hotkey-label: "";
    in-out property <string> catalog-project-hotkey-label: "";
    in property <string> audio-preview-hotkey-label: "Ctrl+P";
    in property <bool> auto-preview-audio: false;
    in property <bool> preview-active: false;
    in property <string> preview-message: "";
    in property <string> preview-time: "";
    in property <float> preview-progress: 0;
    in property <bool> preview-playing: false;
    in property <bool> preview-can-seek: false;
    in property <bool> preview-can-toggle: false;
    in-out property <string> config-path-display: "";
    in-out property <string> settings-feedback: "";
    in-out property <bool> settings-feedback-error: false;
    in property <[EffectItemUI]> results: [];

    callback search-edited(string);
    callback catalog-changed();
    callback step-out-bin();
    callback move-selection(int);
    callback activate-selected();
    callback activate-index(int);
    callback shift-activate-selected();
    callback shift-activate-index(int);
    callback close-requested();
    callback toggle-debug-log();
    callback toggle-settings();
    callback hotkey-recording-changed(bool);
    callback capture-shortcut(string, string, bool, bool, bool, bool);
    callback clear-shortcut(string);
    callback reset-default-hotkey();
    callback toggle-default-effect-controls();
    callback set-alternate-modifier(string);
    callback try-palette-shortcut(string, bool, bool, bool, bool, bool) -> bool;
    callback toggle-auto-preview-audio();
    callback toggle-preview-playback();
    callback seek-audio-preview(float);
    callback open-config-file();
    callback reload-settings();

    public function focus-search() {
        search-input.focus();
        search-input.select-all();
    }

    function begin-recording(target: string) {
        if (root.recording-target == target && root.recording-hotkey) {
            root.set-recording(false);
            return;
        }
        root.recording-target = target;
        root.set-recording(true);
    }

    function set-recording(active: bool) {
        if (!active) {
            root.recording-target = "";
        }
        if (root.recording-hotkey != active) {
            root.recording-hotkey = active;
            root.hotkey-recording-changed(active);
        }
        if (active) {
            if (root.recording-target == "") {
                root.recording-target = "launch";
            }
            root.settings-feedback = "";
            root.settings-feedback-error = false;
            recorder-focus.focus();
        } else if (root.settings-open) {
            settings-focus.focus();
        }
    }

    changed settings-open => {
        if (root.settings-open) {
            root.settings-tab-index = 0;
            if (!root.recording-hotkey) {
                settings-focus.focus();
            }
        }
    }

    function select-settings-tab(index: int) {
        if (root.settings-tab-index != index) {
            root.set-recording(false);
            root.settings-tab-index = index;
            settings-focus.focus();
        }
    }

    function is-alternate-modifier(mods: KeyboardModifiers) -> bool {
        return root.alternate-modifier == "ctrl" ? mods.control
            : root.alternate-modifier == "alt" ? mods.alt
            : mods.shift;
    }

    function switch-catalog() {
        root.select-catalog(root.active-catalog == "all" ? "effects"
            : root.active-catalog == "effects" ? "project" : "all");
    }

    function select-catalog(catalog: string) {
        if (root.active-catalog != catalog) {
            root.active-catalog = catalog;
            root.catalog-changed();
        }
        search-input.focus();
    }

    // Catch palette navigation and Escape even if the search input is not focused.
    FocusScope {
        width: 100%;
        height: 100%;
        forward-focus: search-input;

        key-pressed(event) => {
            if (root.settings-open) {
                if (event.text == Key.Escape) {
                    if (root.recording-hotkey) {
                        root.set-recording(false);
                    } else {
                        root.toggle-settings();
                    }
                    return accept;
                }
                if (!root.recording-hotkey && root.try-palette-shortcut(
                    event.text,
                    event.modifiers.control,
                    event.modifiers.alt,
                    event.modifiers.shift,
                    event.modifiers.meta,
                    event.repeat,
                )) {
                    return accept;
                }
                if (event.text == Key.F12 && !root.recording-hotkey) {
                    root.toggle-debug-log();
                    return accept;
                }
                if (!root.recording-hotkey && !event.modifiers.control && !event.modifiers.alt
                    && !event.modifiers.shift && !event.modifiers.meta
                    && (event.text == Key.LeftArrow || event.text == Key.RightArrow)) {
                    root.select-settings-tab((root.settings-tab-index + (event.text == Key.LeftArrow ? -1 : 1)).clamp(0, 2));
                    return accept;
                }
                return reject;
            }
            if (root.try-palette-shortcut(
                event.text,
                event.modifiers.control,
                event.modifiers.alt,
                event.modifiers.shift,
                event.modifiers.meta,
                event.repeat,
            )) {
                return accept;
            }
            if (event.text == Key.Return && root.is-alternate-modifier(event.modifiers)) {
                root.shift-activate-selected();
                return accept;
            }
            if (event.text == Key.Backspace && root.search-text == "" && root.active-bin != "") {
                root.step-out-bin();
                return accept;
            }
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.move-selection(-1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.move-selection(1);
                return accept;
            }
            if (event.text == Key.Tab) {
                root.switch-catalog();
                return accept;
            }
            if (event.text == Key.F12) {
                root.toggle-debug-log();
                return accept;
            }
            return reject;
        }

        // Outer bordered shell
        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.window-background;
            border-radius: 10px;
            clip: true;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Search bar or Settings header
            Rectangle {
                height: root.settings-open ? 54px : 50px;
                background: Theme.header-background;

                HorizontalLayout {
                    visible: root.settings-open;
                    width: 100%;
                    height: 100%;
                    padding-left: 16px;
                    padding-right: 14px;
                    spacing: 12px;
                    alignment: stretch;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "Settings";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.primary-text;
                        }
                        Text {
                            visible: root.settings-tab-index == 0;
                            text: "Hotkeys and preferences apply immediately";
                            font-size: 11px;
                            color: Theme.muted-text;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 72px;
                            height: 26px;
                            border-radius: 6px;
                            background: back-touch.has-hover ? Theme.control-hover : Theme.control-background;
                            border-width: 1px;
                            border-color: Theme.outline;
                            accessible-role: button;
                            accessible-label: "Back to search";
                            accessible-action-default => { root.toggle-settings(); }
                            Text {
                                text: "← Back";
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.result-text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            back-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-settings(); }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    visible: !root.settings-open;
                    y: 0px;
                    width: 100%;
                    height: 100%;
                    padding-left: 16px;
                    padding-right: 14px;
                    spacing: 12px;
                    alignment: stretch;

                    if root.active-bin != "" : VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 24px;
                            max-width: 210px;
                            border-radius: 6px;
                            background: bin-touch.has-hover ? Theme.project-hover : Theme.project-tint;
                            border-width: 1px;
                            border-color: Theme.project-outline;
                            accessible-role: button;
                            accessible-label: "Inside bin " + root.active-bin + ". Step up one level";
                            accessible-action-default => { root.step-out-bin(); }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 7px;
                                spacing: 5px;
                                alignment: center;
                                Text {
                                    text: root.active-bin;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: Theme.project-emphasis;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: "×";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: Theme.project-accent;
                                    vertical-alignment: center;
                                }
                            }
                            bin-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.step-out-bin(); }
                            }
                            Tooltip {
                                text: @markdown("\{root.active-bin} (Backspace or click to go up)");
                            }
                        }
                    }

                    // Input box container
                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;

                        // Placeholder text when empty
                        if root.search-text == "" : Text {
                            x: 0px;
                            width: 100%;
                            height: 100%;
                            text: root.active-bin != "" ? "Search in \{root.active-bin}…"
                                : root.active-catalog == "effects" ? "Search effects and transitions…"
                                : root.active-catalog == "project" ? "Search project items…"
                                : "Search effects and project items…";
                            color: Theme.placeholder-text;
                            font-size: 13.5px;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        search-input := TextInput {
                            enabled: !root.settings-open;
                            x: 0px;
                            width: 100%;
                            height: 100%;
                            text <=> root.search-text;
                            font-size: 15px;
                            color: Theme.primary-text;
                            selection-background-color: Theme.text-selection;
                            selection-foreground-color: Theme.text-selection-foreground;
                            vertical-alignment: center;
                            single-line: true;

                            edited => {
                                root.search-edited(self.text);
                            }

                            accepted => {
                                root.activate-selected();
                            }

                            key-pressed(event) => {
                                if (root.try-palette-shortcut(
                                    event.text,
                                    event.modifiers.control,
                                    event.modifiers.alt,
                                    event.modifiers.shift,
                                    event.modifiers.meta,
                                    event.repeat,
                                )) {
                                    return accept;
                                }
                                if (event.text == Key.Return && root.is-alternate-modifier(event.modifiers)) {
                                    root.shift-activate-selected();
                                    return accept;
                                }
                                if (event.text == Key.Backspace && root.search-text == "" && root.active-bin != "") {
                                    root.step-out-bin();
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    root.move-selection(-1);
                                    return accept;
                                }
                                if (event.text == Key.DownArrow) {
                                    root.move-selection(1);
                                    return accept;
                                }
                                if (event.text == Key.Tab) {
                                    root.switch-catalog();
                                    return accept;
                                }
                                if (event.text == Key.F12) {
                                    root.toggle-debug-log();
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                }

            }

            Rectangle {
                height: 1px;
                background: Theme.section-divider;
            }

            if !root.settings-open : Rectangle {
                height: 36px;
                background: Theme.strip-background;
                accessible-role: tab-list;
                accessible-label: "Search catalogs";
                accessible-item-count: 3;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 8px;
                    alignment: start;

                    for catalog[index] in [
                        { id: "all", label: "All", name: "All", accent: Theme.catalog-all },
                        { id: "effects", label: "FX", name: "Effects", accent: Theme.catalog-effects },
                        { id: "project", label: "PRJ", name: "Project", accent: Theme.catalog-project },
                    ] : Rectangle {
                        private property <bool> active: catalog.id == root.active-catalog;
                        width: 46px;
                        border-radius: 5px;
                        background: active ? catalog.accent.with-alpha(0.12) : transparent;
                        border-width: active ? 1px : 0px;
                        border-color: catalog.accent.with-alpha(0.4);
                        accessible-role: tab;
                        accessible-label: catalog.name;
                        accessible-item-index: index;
                        accessible-item-selectable: true;
                        accessible-item-selected: active;
                        accessible-action-default => { root.select-catalog(catalog.id); }
                        Text {
                            text: catalog.label;
                            font-size: 11px;
                            font-weight: 700;
                            color: active ? catalog.accent : Theme.tab-text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.select-catalog(catalog.id); }
                        }
                    }
                }
            }

            if !root.settings-open : Rectangle {
                height: 1px;
                background: Theme.section-divider;
            }

            // Eight visible results (or Settings panel)
            Rectangle {
                min-height: 314px;
                vertical-stretch: 1;
                background: Theme.window-background;
                clip: true;

                // Settings tabs and their content
                Rectangle {
                    visible: root.settings-open;
                    width: 100%;
                    height: 100%;

                    settings-focus := FocusScope {
                        width: 0px;
                        height: 0px;
                        enabled: root.settings-open && !root.recording-hotkey;
                    }

                    recorder-focus := FocusScope {
                        width: 0px;
                        height: 0px;
                        enabled: root.settings-open && root.recording-hotkey;
                        key-pressed(event) => {
                            if (!root.recording-hotkey) {
                                return reject;
                            }
                            if (event.text == Key.Escape) {
                                root.set-recording(false);
                                return accept;
                            }
                            root.capture-shortcut(
                                root.recording-target,
                                event.text,
                                event.modifiers.control,
                                event.modifiers.alt,
                                event.modifiers.shift,
                                event.modifiers.meta,
                            );
                            return accept;
                        }
                    }

                    VerticalLayout {
                        width: 100%;
                        height: 100%;
                        padding: 0px;
                        spacing: 0px;

                        Rectangle {
                            height: 38px;
                            background: Theme.header-background;
                            accessible-role: tab-list;
                            accessible-label: "Settings sections";
                            accessible-item-count: 3;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-top: 5px;
                                padding-bottom: 6px;
                                spacing: 6px;
                                alignment: start;

                                for title[index] in ["Shortcuts", "Appearance", "About"] : Rectangle {
                                    width: 88px;
                                    border-radius: 6px;
                                    background: index == root.settings-tab-index ? Theme.selected-tab-background
                                        : (tab-touch.has-hover ? Theme.tab-hover : transparent);
                                    border-width: index == root.settings-tab-index ? 1px : 0px;
                                    border-color: Theme.selected-tab-outline;
                                    accessible-role: tab;
                                    accessible-label: title;
                                    accessible-item-index: index;
                                    accessible-item-selectable: true;
                                    accessible-item-selected: index == root.settings-tab-index;
                                    accessible-action-default => { root.select-settings-tab(index); }
                                    Text {
                                        text: title;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: index == root.settings-tab-index ? Theme.selected-tab-text : Theme.tab-text;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    tab-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.select-settings-tab(index); }
                                    }
                                }
                            }
                        }

                        if root.settings-tab-index == 2 : VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            spacing: 6px;

                            Text {
                                text: "Version: " + root.app-version;
                                font-size: 15px;
                                font-weight: 600;
                                color: Theme.selected-tab-text;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Developed by Vee Jay";
                                font-size: 13px;
                                color: Theme.tab-text;
                                horizontal-alignment: center;
                            }

                            HorizontalLayout {
                                alignment: center;

                                AboutSlint {
                                    width: 172px;
                                    height: 110px;
                                }
                            }
                        }

                        if root.settings-tab-index != 2 && root.settings-feedback != "" : Rectangle {
                            background: root.settings-feedback-error ? Theme.error-background : Theme.success-background;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                Text {
                                    text: root.settings-feedback;
                                    font-size: 11px;
                                    color: root.settings-feedback-error ? Theme.error-text : Theme.success-text;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        if root.settings-tab-index == 1 : VerticalLayout {
                            vertical-stretch: 1;
                            alignment: start;
                            padding: 14px;

                            Rectangle {
                                height: 60px;
                                background: Theme.header-background;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.card-border;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;

                                    Text {
                                        text: "Theme";
                                        color: Theme.primary-text;
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        width: 172px;

                                        ComboBox {
                                            accessible-label: "Theme";
                                            model: root.theme-options;
                                            current-index <=> root.theme-selection;
                                            selected(value) => {
                                                root.select-theme(value);
                                                // The widget tracks the value and index separately.
                                                self.current-value = root.theme-name;
                                                root.theme-selection = root.saved-theme-index;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if root.settings-tab-index == 0 : Flickable {
                            vertical-stretch: 1;
                            content-height: settings-list.preferred-height;
                            interactive: true;

                            settings-list := VerticalLayout {
                                width: 100%;
                                padding: 14px;
                                spacing: 10px;
                                alignment: start;

                                // Card 1: Launch Hotkey
                                Rectangle {
                                    background: Theme.header-background;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.card-border;

                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 8px;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: stretch;

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text {
                                                    text: "Launch Hotkey";
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    color: Theme.primary-text;
                                                }
                                                Text {
                                                    text: "Global shortcut to open Spotlight in Premiere Pro";
                                                    font-size: 11px;
                                                    color: Theme.muted-text;
                                                    overflow: elide;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: 6px;
                                                alignment: center;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        min-width: 122px;
                                                        height: 28px;
                                                        border-radius: 6px;
                                                        background: (root.recording-hotkey && root.recording-target == "launch") ? Theme.accent-tint
                                                            : (record-touch.has-hover ? Theme.shortcut-hover : Theme.shortcut-background);
                                                        border-width: 1px;
                                                        border-color: (root.recording-hotkey && root.recording-target == "launch") ? Theme.focus-outline : Theme.shortcut-border;
                                                        accessible-role: button;
                                                        accessible-label: "Change launch hotkey";
                                                        accessible-action-default => { root.begin-recording("launch"); }

                                                        HorizontalLayout {
                                                            padding-left: 10px;
                                                            padding-right: 10px;
                                                            alignment: center;
                                                            Text {
                                                                text: (root.recording-hotkey && root.recording-target == "launch") ? "Press keys…" : root.hotkey-label;
                                                                font-size: 11.5px;
                                                                font-weight: 700;
                                                                color: (root.recording-hotkey && root.recording-target == "launch") ? Theme.accent-text : Theme.shortcut-text;
                                                                horizontal-alignment: center;
                                                                vertical-alignment: center;
                                                            }
                                                        }

                                                        record-touch := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => { root.begin-recording("launch"); }
                                                        }
                                                        Tooltip {
                                                            text: @markdown("Click then press a new key combination (Esc to cancel)");
                                                        }
                                                    }
                                                }

                                                if root.hotkey-label != "Ctrl+Space" : VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 52px;
                                                        height: 28px;
                                                        border-radius: 6px;
                                                        background: reset-touch.has-hover ? Theme.control-hover : Theme.control-background;
                                                        border-width: 1px;
                                                        border-color: Theme.outline;
                                                        accessible-role: button;
                                                        accessible-label: "Reset hotkey to Ctrl+Space";
                                                        accessible-action-default => { root.reset-default-hotkey(); }
                                                        Text {
                                                            text: "Reset";
                                                            font-size: 11px;
                                                            font-weight: 600;
                                                            color: Theme.control-text;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                        }
                                                        reset-touch := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.set-recording(false);
                                                                root.reset-default-hotkey();
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Card 2: Effect Controls on Enter
                                Rectangle {
                                    background: Theme.header-background;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.card-border;

                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 12px;
                                        alignment: stretch;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: "Always open Effect Controls on Enter";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: Theme.primary-text;
                                            }
                                            Text {
                                                text: root.open-effect-controls-default
                                                    ? "Enter applies & opens Effect Controls · " + root.alternate-modifier-label + "+Enter applies only"
                                                    : "Enter applies only · " + root.alternate-modifier-label + "+Enter opens Effect Controls";
                                                font-size: 11px;
                                                color: Theme.muted-text;
                                                overflow: elide;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            SettingsToggle {
                                                checked: root.open-effect-controls-default;
                                                label: "Always open Effect Controls on Enter";
                                                toggled => {
                                                    root.set-recording(false);
                                                    root.toggle-default-effect-controls();
                                                }
                                            }
                                        }
                                    }
                                }

                                // Card 3: Alternate Action Modifier
                                Rectangle {
                                    background: Theme.header-background;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.card-border;

                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 12px;
                                        alignment: stretch;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: "Alternate Action Modifier";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: Theme.primary-text;
                                            }
                                            Text {
                                                text: root.alternate-modifier-label + "+Enter / " + root.alternate-modifier-label + "+Click triggers Source Monitor or Effect Controls swap";
                                                font-size: 11px;
                                                color: Theme.muted-text;
                                                overflow: elide;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 4px;
                                            alignment: center;

                                            for opt in [
                                                { id: "shift", title: "Shift" },
                                                { id: "ctrl", title: "Ctrl" },
                                                { id: "alt", title: "Alt" },
                                            ] : VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 44px;
                                                    height: 26px;
                                                    border-radius: 5px;
                                                    background: root.alternate-modifier == opt.id ? Theme.accent-tint
                                                        : (mod-touch.has-hover ? Theme.control-hover : Theme.control-background);
                                                    border-width: 1px;
                                                    border-color: root.alternate-modifier == opt.id ? Theme.focus-outline : Theme.outline;
                                                    Text {
                                                        text: opt.title;
                                                        font-size: 11px;
                                                        font-weight: root.alternate-modifier == opt.id ? 700 : 500;
                                                        color: root.alternate-modifier == opt.id ? Theme.accent-text : Theme.control-text;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    mod-touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.set-recording(false);
                                                            root.set-alternate-modifier(opt.id);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Card 4: Open Settings Shortcut
                                Rectangle {
                                    background: Theme.header-background;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.card-border;

                                    VerticalLayout {
                                        padding: 12px;
                                        ShortcutRecorderRow {
                                            label: "Open Settings Shortcut";
                                            hint: "Press inside Spotlight to toggle Settings";
                                            shortcut-text: root.settings-hotkey-label;
                                            recording: root.recording-hotkey && root.recording-target == "settings";
                                            toggle-record => { root.begin-recording("settings"); }
                                            clear-clicked => {
                                                root.set-recording(false);
                                                root.clear-shortcut("settings");
                                            }
                                        }
                                    }
                                }

                                // Card 5: Direct Catalog Shortcuts
                                Rectangle {
                                    background: Theme.header-background;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.card-border;

                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 8px;

                                        ShortcutRecorderRow {
                                            label: "Switch to All Catalog";
                                            hint: "Optional shortcut inside Spotlight (empty by default)";
                                            shortcut-text: root.catalog-all-hotkey-label;
                                            recording: root.recording-hotkey && root.recording-target == "catalog_all";
                                            toggle-record => { root.begin-recording("catalog_all"); }
                                            clear-clicked => {
                                                root.set-recording(false);
                                                root.clear-shortcut("catalog_all");
                                            }
                                        }

                                        ShortcutRecorderRow {
                                            label: "Switch to Effects Catalog";
                                            shortcut-text: root.catalog-effects-hotkey-label;
                                            recording: root.recording-hotkey && root.recording-target == "catalog_effects";
                                            toggle-record => { root.begin-recording("catalog_effects"); }
                                            clear-clicked => {
                                                root.set-recording(false);
                                                root.clear-shortcut("catalog_effects");
                                            }
                                        }

                                        ShortcutRecorderRow {
                                            label: "Switch to Project Catalog";
                                            shortcut-text: root.catalog-project-hotkey-label;
                                            recording: root.recording-hotkey && root.recording-target == "catalog_project";
                                            toggle-record => { root.begin-recording("catalog_project"); }
                                            clear-clicked => {
                                                root.set-recording(false);
                                                root.clear-shortcut("catalog_project");
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    background: Theme.header-background;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.card-border;

                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 8px;

                                        ShortcutRecorderRow {
                                            label: "Preview Audio Shortcut";
                                            shortcut-text: root.audio-preview-hotkey-label;
                                            recording: root.recording-hotkey && root.recording-target == "audio_preview";
                                            toggle-record => { root.begin-recording("audio_preview"); }
                                            clear-clicked => {
                                                root.set-recording(false);
                                                root.clear-shortcut("audio_preview");
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: "Auto-preview audio";
                                                font-size: 12px;
                                                color: Theme.primary-text;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                            SettingsToggle {
                                                checked: root.auto-preview-audio;
                                                label: "Auto-preview audio";
                                                toggled => {
                                                    root.set-recording(false);
                                                    root.toggle-auto-preview-audio();
                                                }
                                            }
                                        }
                                    }
                                }

                                // Config file location & actions
                                Rectangle {
                                    background: Theme.header-background;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.card-border;

                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 10px;
                                        alignment: stretch;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: "Config File";
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: Theme.primary-text;
                                            }
                                            Text {
                                                text: root.config-path-display;
                                                font-size: 10.5px;
                                                font-family: "Consolas";
                                                color: Theme.muted-text;
                                                overflow: elide;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: center;

                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 72px;
                                                    height: 26px;
                                                    border-radius: 6px;
                                                    background: open-cfg-touch.has-hover ? Theme.control-hover : Theme.control-background;
                                                    border-width: 1px;
                                                    border-color: Theme.outline;
                                                    accessible-role: button;
                                                    accessible-label: "Open config file";
                                                    accessible-action-default => { root.open-config-file(); }
                                                    Text {
                                                        text: "Open File";
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        color: Theme.control-text;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    open-cfg-touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.set-recording(false);
                                                            root.open-config-file();
                                                        }
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 58px;
                                                    height: 26px;
                                                    border-radius: 6px;
                                                    background: reload-cfg-touch.has-hover ? Theme.control-hover : Theme.control-background;
                                                    border-width: 1px;
                                                    border-color: Theme.outline;
                                                    accessible-role: button;
                                                    accessible-label: "Reload config file";
                                                    accessible-action-default => { root.reload-settings(); }
                                                    Text {
                                                        text: "Reload";
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        color: Theme.control-text;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    reload-cfg-touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.set-recording(false);
                                                            root.reload-settings();
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if !root.settings-open && root.results.length == 0 : VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.active-bin != "" && root.search-text == "" ? "This bin is empty"
                            : root.show-recent-items ? "No recently added items"
                            : "No matching results";
                        font-size: 13px;
                        color: Theme.subtle-text;
                        horizontal-alignment: center;
                    }
                }

                VerticalLayout {
                    visible: !root.settings-open;
                    width: 100%;
                    height: 100%;
                    padding: 6px;
                    spacing: 2px;
                    alignment: start;

                    for item[idx] in root.results : Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        clip: true;
                        background: idx == root.selected-index ? Theme.row-selected : (row-touch.has-hover ? Theme.row-hover : transparent);
                        border-width: idx == root.selected-index ? 1px : 0px;
                        border-color: Theme.row-outline;

                        row-touch := TouchArea {
                            property <bool> shift-click;
                            mouse-cursor: pointer;
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down) {
                                    self.shift-click = root.is-alternate-modifier(event.modifiers);
                                }
                            }
                            clicked => {
                                if (self.shift-click) {
                                    root.shift-activate-index(idx);
                                } else {
                                    root.activate-index(idx);
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;

                            // Category pill
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: category-label.preferred-width + 14px;
                                    height: 20px;
                                    border-radius: 4px;
                                    background: Theme.indigo ? item.badge-bg : item.badge-fg.with-alpha(Theme.light ? 0.26 : 0.14);
                                    category-label := Text {
                                        text: item.category;
                                        font-size: 10px;
                                        font-weight: 600;
                                        color: Theme.indigo ? item.badge-fg : item.badge-fg.mix(Theme.primary-text, Theme.light ? 0.20 : 0.75);
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Result name and selected project item's bin path side-by-side
                            HorizontalLayout {
                                horizontal-stretch: 1;
                                spacing: 10px;

                                VerticalLayout {
                                    horizontal-stretch: (idx == root.selected-index && item.folder != "") ? 0 : 1;
                                    max-width: (idx == root.selected-index && item.folder != "") ? 260px : 1000px;
                                    alignment: center;
                                    Text {
                                        text: item.name;
                                        font-size: 13px;
                                        font-weight: idx == root.selected-index ? 600 : 400;
                                        color: idx == root.selected-index ? Theme.row-selected-text : Theme.result-text;
                                        overflow: elide;
                                    }
                                }

                                if idx == root.selected-index && item.folder != "" : Text {
                                    min-width: 0px;
                                    horizontal-stretch: 1;
                                    text: item.folder;
                                    font-size: 10.5px;
                                    color: Theme.breadcrumb-text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            if root.preview-active && idx == root.selected-index : VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 32px;
                                    height: 24px;
                                    border-radius: 5px;
                                    background: playback-button.has-hover ? Theme.accent-hover : transparent;
                                    accessible-role: button;
                                    accessible-label: !root.preview-can-toggle ? "Loading audio preview"
                                        : root.preview-playing ? "Pause audio preview" : "Play audio preview";
                                    accessible-enabled: root.preview-can-toggle;
                                    accessible-action-default => {
                                        if root.preview-can-toggle { root.toggle-preview-playback(); }
                                    }
                                    Path {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 12px;
                                        height: 12px;
                                        viewbox-width: 12;
                                        viewbox-height: 12;
                                        fill: root.preview-can-toggle ? Theme.accent-text : Theme.preview-disabled;
                                        commands: root.preview-playing
                                            ? "M2 1 H5 V11 H2 Z M7 1 H10 V11 H7 Z"
                                            : "M2 1 L11 6 L2 11 Z";
                                    }
                                    playback-button := TouchArea {
                                        mouse-cursor: root.preview-can-toggle ? MouseCursor.pointer : MouseCursor.default;
                                        clicked => {
                                            if root.preview-can-toggle { root.toggle-preview-playback(); }
                                        }
                                    }
                                }
                            }

                        }

                        if root.preview-active && idx == root.selected-index && root.preview-can-seek : Rectangle {
                            x: 0px;
                            y: parent.height - self.height - 1px;
                            width: parent.width;
                            height: 8px;
                            accessible-role: slider;
                            accessible-label: "Audio preview position";
                            accessible-value: root.preview-progress;
                            accessible-value-minimum: 0;
                            accessible-value-maximum: 1;
                            accessible-action-increment => {
                                root.seek-audio-preview(min(1, root.preview-progress + 0.05));
                            }
                            accessible-action-decrement => {
                                root.seek-audio-preview(max(0, root.preview-progress - 0.05));
                            }
                            accessible-action-set-value(value) => {
                                if value.is-float() { root.seek-audio-preview(value.to-float()); }
                            }

                            Rectangle {
                                y: parent.height - self.height - 1px;
                                width: 100%;
                                height: 2px;
                                border-radius: 1px;
                                background: Theme.progress-track;
                                Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width * root.preview-progress;
                                    height: parent.height;
                                    border-radius: parent.border-radius;
                                    background: Theme.progress-fill;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.seek-audio-preview(self.mouse-x / self.width); }
                            }
                            Tooltip {
                                text: @markdown("\{root.preview-time}");
                            }
                        }
                    }
                }
            }

            // Divider
            Rectangle {
                height: 1px;
                background: Theme.footer-divider;
            }

            // Footer
            Rectangle {
                height: 36px;
                background: Theme.strip-background;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;

                    // Connection status indicator
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        spacing: 7px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 7px;
                                height: 7px;
                                border-radius: 3.5px;
                                background: root.bridge-connected ? Theme.connected : Theme.warning;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: root.preview-message != "" ? root.preview-message : root.status-message;
                                font-size: 11px;
                                color: Theme.muted-text;
                                wrap: word-wrap;
                                height: 30px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    if !root.settings-open : VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.show-recent-items ? "Recently added"
                                : root.total-matches == 1 ? "1 result" : root.total-matches + " results";
                            font-size: 11px;
                            color: Theme.muted-text;
                        }
                    }

                    // Lower-right Settings gear button
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 5px;
                            background: root.settings-open ? Theme.accent-hover
                                : (gear-touch.has-hover ? Theme.shortcut-hover : transparent);
                            border-width: root.settings-open ? 1px : 0px;
                            border-color: Theme.focus-outline-soft;
                            accessible-role: button;
                            accessible-label: root.settings-open ? "Close settings" : "Open settings";
                            accessible-action-default => { root.toggle-settings(); }

                            Path {
                                x: 5px;
                                y: 5px;
                                width: 14px;
                                height: 14px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                fill: root.settings-open ? Theme.accent-text
                                    : (gear-touch.has-hover ? Theme.result-text : Theme.muted-text);
                                commands: "M19.14 12.94c.04-.31.06-.63.06-.94s-.02-.63-.06-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96a7.03 7.03 0 0 0-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.44.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.74 8.87a.48.48 0 0 0 .12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.49.38 1.03.7 1.62.94l.36 2.54c.03.24.23.41.47.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.48.48 0 0 0-.12-.61l-2.01-1.58z";
                            }
                            Rectangle {
                                x: 9.5px;
                                y: 9.5px;
                                width: 5px;
                                height: 5px;
                                border-radius: 2.5px;
                                background: root.settings-open ? Theme.settings-icon-center : (gear-touch.has-hover ? Theme.shortcut-hover : Theme.strip-background);
                            }

                            gear-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-settings(); }
                            }
                            Tooltip {
                                text: @markdown("\{root.gear-tooltip}");
                            }
                        }
                    }

                }
            }
        }
        }
    }

    // Draw the outline over the content at the native window edge.
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        border-width: 1.5px;
        border-color: Theme.outline;
        border-radius: 10px;
    }
}
